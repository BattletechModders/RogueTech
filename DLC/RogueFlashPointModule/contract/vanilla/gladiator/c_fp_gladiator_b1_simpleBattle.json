  "dialogueList": [
    {
      "dialogue": {
        "EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
      },
      "name": "Dialogue_MissionStart",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "You're here… and look, you've brought friends! You're a LIAR and a CHEAT, and you're gonna REAP THE STEEL BEAST'S WHIRLWIND!",
          "selectedCastDefId": "castDef_FP_gladiator_SteelBeastDefault",
          "audioName": "NONE"
        },
        {
          "words": "Shut up and fight, you murderous swine. Commander {COMMANDER.LastName} will make you suffer, as you made my nephew Arjun suffer!",
          "selectedCastDefId": "castDef_SteinerRepDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "d9a28c08-abdb-42bb-a140-ad3927d1f8cf"
        },
        {
          "words": "SUFFERING? <i>I'LL SHOW YOU SUFFERING!</i> Now COME AT ME!",
          "selectedCastDefId": "castDef_FP_gladiator_SteelBeastDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
      },
      "name": "Dialogue_MissionSuccess",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Scratch one Steel Beast. He had it coming, I have to say.",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE"
        },
        {
          "words": "And you delivered it to him! I salute you, Commander—prost!",
          "selectedCastDefId": "castDef_SteinerRepDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
      },
      "name": "Dialogue_MissionFailure",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "RRRR<i>AAAAAAGGGGH!</i> STEEL BEAST! STEEL BEAST! <i>STEEEEEL BEEEEEAST!</i>",
          "selectedCastDefId": "castDef_FP_gladiator_SteelBeastDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "33166b96-5af2-4724-b970-7884ec41ffd0"
      },
      "name": "Dialogue_AmbushWarning",
      "overrideDialogueBucketId": "DialogBucketDef_Universal_HostilesInbound",
      "dialogueContent": [
        {
          "words": "A primary target is damaged, Commander! Keep it up!",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    }
  ],
