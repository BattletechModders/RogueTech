  "dialogueList": [
    {
      "dialogue": {
        "EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
      },
      "name": "Dialogue_MissionStart",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "You're running, eh? Fleeing like a craven? Let me guess: you want to use the array to expedite your escape.",
          "selectedCastDefId": "castDef_FP_longHunt_LeesDefault",
          "audioName": "NONE"
        },
        {
          "words": "That's about the shape of it. And you're too far away to stop us.",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "181efcdf-0e34-477b-8a06-39b0ead2d69e"
        },
        {
          "words": "I am, am I? Go on, then—take your shot. Let's see how far it gets you.",
          "selectedCastDefId": "castDef_FP_longHunt_LeesDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "181efcdf-0e34-477b-8a06-39b0ead2d69e"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
      },
      "name": "Dialogue_MissionSuccess",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "The sensor array is ours! Dr. Murad, do you have the access you need to break Lees's target lock on the <i>Argo</i>?",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "Already done, XO—we are clear to turn tail and run. I'll bet that Lees is having a good laugh at our expense.",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE"
        },
        {
          "words": "He can laugh all he likes. If we live through this, I'm counting it a win. Now buckle in, everyone—I'm getting us the hell out of here!",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
      },
      "name": "Dialogue_MissionFailure",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "This contest is over, Commander… you were outmatched from the start. Now go. Slink away from this world and never return.",
          "selectedCastDefId": "castDef_FP_longHunt_LeesDefault",
          "audioName": "NONE"
        },
        {
          "words": "You're gonna kill us as soon as we turn our backs on you.",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE"
        },
        {
          "words": "I could kill you <i>now</i> if I wanted to. But shooting a downed foe isn't sporting, and I'd prefer to let you stew in your own humiliation. Now run along before I change my mind.",
          "selectedCastDefId": "castDef_FP_longHunt_LeesDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "692713e2-ddc8-4e4e-963b-81163f2fc598"
      },
      "name": "Dialogue_EnemiesSpotted",
      "overrideDialogueBucketId": "DialogBucketDef_Universal_HostilesInbound",
      "dialogueContent": [
        {
          "words": "Bogeys on sensors!",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "9071057f-44c7-44ee-a23e-10bc7bab3e00"
      },
      "name": "Dialogue_GoToComplete_EnemiesRemain",
      "overrideDialogueBucketId": "DialogBucketDef_CaptureBase_AreaNotClear",
      "dialogueContent": [
        {
          "words": "[GENERIC VO] Area is not clear, Commander. Eliminate the hostiles before continuing to the next Objective.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "774f075d-acb4-43d0-aeb2-607292ecd3db"
      },
      "name": "Dialogue_EnemiesComplete_GoToRemain",
      "overrideDialogueBucketId": "DialogBucketDef_CaptureBase_GoToNextObj",
      "dialogueContent": [
        {
          "words": "[GENERIC VO] Sensors are clear, proceed to the next objective.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d61f12a3-f820-4026-b7ca-9d263d1525fa"
      },
      "name": "Dialogue_Interrupt_DropshipLanding",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Get ready for extraction! I'm coming in hot!",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "9193a080-418b-4e46-aeb0-f8ac55fb63b5"
      },
      "name": "Dialogue_Interrupt_TurretWarning",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "We've got turrets powering up at the sensor array, Commander. Take 'em out before they take you out!",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "9a1bfa77-fc82-4e20-be61-63ebe1d1949e"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "37173dfd-65d9-40dc-b498-906086595931"
      },
      "name": "Dialogue_Interrupt_GoToComplete",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "This is an automated facility, Commander—there are no active personnel on site, but we do have turrets to worry about.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "a85da736-7a2e-4cc6-aff3-feb9d73fc7e1"
        },
        {
          "words": "Press onward, but keep your eyes open for additional contacts. This planet is crawling with defenders, and we can't afford to let our guard down.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    }
  ],
