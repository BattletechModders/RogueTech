  "dialogueList": [
    {
      "dialogue": {
        "EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
      },
      "name": "Dialogue_MissionStart",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Thank the gods, the cavalry is here at last. Commander {COMMANDER.LastName}, you are a lifesaver, and I do mean that literally.",
          "selectedCastDefId": "castDef_FP_friendInNeed_GwydionDefault",
          "audioName": "NONE"
        },
        {
          "words": "Just sit tight, Carronade. We'll handle the strike team and get your people out of here.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "d9a28c08-abdb-42bb-a140-ad3927d1f8cf"
        },
        {
          "words": "You're doing us a solid, {COMMANDER.Callsign}—and I promise that if you get us out of this, I won't forget it. Carronade out.",
          "selectedCastDefId": "castDef_FP_friendInNeed_GwydionDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
      },
      "name": "Dialogue_MissionSuccess",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "You've saved us, Commander. Gwydion Company owes you one.",
          "selectedCastDefId": "castDef_FP_friendInNeed_GwydionDefault",
          "audioName": "NONE"
        },
        {
          "words": "Yes, you do, Commander Carnby. And you'd better believe that we're gonna remember it.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "Roger that, Mr. Oliveira—in your position, you'd better believe I'd do the same. Drinks are on us when we get out of here. Carronade out.",
          "selectedCastDefId": "castDef_FP_friendInNeed_GwydionDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
      },
      "name": "Dialogue_MissionFailure",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "I don't know what went wrong, Commander, but we need to evac.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "33166b96-5af2-4724-b970-7884ec41ffd0"
      },
      "name": "Dialogue_AmbushWarning",
      "overrideDialogueBucketId": "DialogBucketDef_Universal_HostilesInbound",
      "dialogueContent": [
        {
          "words": "A primary target is damaged, Commander! Keep it up!",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    }
  ],
