  "dialogueList": [
    {
      "dialogue": {
        "EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
      },
      "name": "Dialogue_MissionStart",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "What an ugly place this is. At any rate, this is the region my staff believes the convoy will be traveling through.",
          "selectedCastDefId": "castDef_KuritaRepDefault",
          "audioName": "audioevent_universal_hostilesInbound"
        },
        {
          "words": "Move to where you can observe its route, and see what we're actually dealing with.",
          "selectedCastDefId": "castDef_KuritaRepDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "cb50e1e4-aa0c-49b2-bd2e-5339c78dafb5"
        },
        {
          "words": "Once the vehicles are all destroyed, I'll instruct a Leopard we have on station to pick you up.",
          "selectedCastDefId": "castDef_KuritaRepDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "a85da736-7a2e-4cc6-aff3-feb9d73fc7e1"
        },
        {
          "words": "This should be simple. Let's finish this quickly.",
          "selectedCastDefId": "castDef_KuritaRepDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "76b654a6-4f2c-4a6f-86e6-d4cf868335fe"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
      },
      "name": "Dialogue_MissionSuccess",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Your performance was acceptable, Commander, but it seems my information was incomplete. Frankly, I'm not surprised by that.",
          "selectedCastDefId": "castDef_KuritaRepDefault",
          "audioName": "NONE"
        },
        {
          "words": "Our ground teams report that none of the vehicles were occupied; they were all remotely piloted—in other words, decoys. How aggravating.",
          "selectedCastDefId": "castDef_KuritaRepDefault",
          "audioName": "NONE"
        },
        {
          "words": "I'll speak to my ISF liaison and see what they believe Nephrite will do next. Expect to deploy again immediately, Commander. I don't want to give him a chance to go to ground.",
          "selectedCastDefId": "castDef_KuritaRepDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
      },
      "name": "Dialogue_MissionFailure",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Did… did you just completely fail to accomplish anything at all, Commander? I lack the words to express my disappointment.",
          "selectedCastDefId": "castDef_KuritaRepDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "2bc99c34-b9a1-4e6d-ad33-a64162819bd0"
      },
      "name": "Dialogue_GoToComplete",
      "overrideDialogueBucketId": "DialogBucketDef_AmbushConvoy_EyesOnTarget",
      "dialogueContent": [
        {
          "words": "We have a lock on the target vehicles. They should be to your front. Engage and destory, Commander.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "7cd7f943-20e7-4b74-9a3c-e1d0cfc30fd9"
      },
      "name": "Dialogue_ConvoyDamaged",
      "overrideDialogueBucketId": "DialogBucketDef_AmbushConvoy_PriTarDamaged",
      "dialogueContent": [
        {
          "words": "That's got it, keep firing on those targets until they are neutralized. ",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "a50ad243-225a-4beb-9317-d7aeffa2bcdc"
      },
      "name": "Dialogue_Interrupt_GuardsDestroyed",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Well <i>done</i>, Commander. You've successfully destroyed all the targets we <i>didn't</i> need killed. Can we wrap this up, please?",
          "selectedCastDefId": "castDef_KuritaRepDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "793629ec-2233-4559-988b-460c5fdf6d58"
      },
      "name": "Dialogue_Interrupt_ConvoyReachedExtraction",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "If those vehicles escape, Commander, I'm going to be very disappointed. I sincerely hope you catch them in time.",
          "selectedCastDefId": "castDef_KuritaRepDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "366443c6-7895-4b4c-aea9-544f1a88c43e"
      },
      "name": "Dialogue_ConvoyTargetDestroyed",
      "overrideDialogueBucketId": "DialogBucketDef_AmbushConvoy_PriTarDamaged",
      "dialogueContent": [
        {
          "words": "One down. Keep engaging those threats and we'll be out of here. ",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "865db024-27b0-4c03-90d6-f257329c5d69"
      },
      "name": "Dialogue_EscapeInstruction",
      "overrideDialogueBucketId": "DialogBucketDef_Universal_Escape",
      "dialogueContent": [
        {
          "words": "The convoy is finished, now get what mechs you have to the extraction point and we'll pull you out. Move quickly.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "22fbc109-89c1-4590-bd94-f2f58e53504f"
      },
      "name": "Dialogue_ReinforcementWarning",
      "overrideDialogueBucketId": "DialogBucketDef_Universal_HostilesInbound",
      "dialogueContent": [
        {
          "words": "Enemy Reinforcements, get ready for contact.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    }
  ],
