  "dialogueList": [
    {
      "dialogue": {
        "EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
      },
      "name": "Dialogue_MissionStart",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Uh, Boss? I'm seeing a couple of Liao attack lances on my screen, and I'm willing to bet their pilots are pretty angry.",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE"
        },
        {
          "words": "I'd wager they're furious. Get in there and take 'em out, but do it carefully. You need to come through this fight in good enough shape to escort the Volkovites to safety.",
          "selectedCastDefId": "castDef_FP_flattenedEarth_SigynDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
      },
      "name": "Dialogue_MissionSuccess",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Impressive work, Commander… this should make evacuating the Volkovites a lot easier. And for what it's worth, I respect the hell out of the fact that you were willing to turn your back on House Liao to help these people.",
          "selectedCastDefId": "castDef_FP_flattenedEarth_SigynDefault",
          "audioName": "NONE"
        },
        {
          "words": "The fact that Persephone Volkov doubled our old contract rates didn't hurt. But between you and me, I'm glad we jumped ship on Lady Marina and the Chancellor.",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE"
        },
        {
          "words": "You're Capellan yourself, aren't you, Mr. Virtanen?",
          "selectedCastDefId": "castDef_FP_flattenedEarth_PersephoneDefault",
          "audioName": "NONE"
        },
        {
          "words": "Born and raised. But I never really bought into the whole \"the state above all\" thing. I think that, deep down, most of us don't.",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE"
        },
        {
          "words": "Let's save the small talk for later, eh? We still need to get Persephone and her people off-planet, and House Liao is bound to have another strike team en route. You need to get them to safety, and you need to do it now.",
          "selectedCastDefId": "castDef_FP_flattenedEarth_SigynDefault",
          "audioName": "NONE"
        },
        {
          "words": "Roger that, Commander Elliathy. We're on our way.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
      },
      "name": "Dialogue_MissionFailure",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "I'm pulling you out, Commander. I feel sorry for the Volkovites, but I won't let our people die for them.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "33166b96-5af2-4724-b970-7884ec41ffd0"
      },
      "name": "Dialogue_AmbushWarning",
      "overrideDialogueBucketId": "DialogBucketDef_Universal_HostilesInbound",
      "dialogueContent": [
        {
          "words": "A primary target is damaged, Commander! Keep it up!",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    }
  ],
