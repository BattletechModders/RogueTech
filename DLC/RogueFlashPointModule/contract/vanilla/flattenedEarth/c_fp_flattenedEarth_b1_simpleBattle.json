  "scope": "MID_CAMPAIGN",
  "finalDifficulty": 0,
  "shortDescription": "Good on you for being on the right side of this conflict, {COMMANDER.Callsign}… I know it couldn't have been an easy decision. And speaking of difficult matters, you're about to have a fight on your hands. House Liao has sent a detachment of 'Mechs to finish your job for you, and unfortunately, Razorback Company is no position to deal with 'em.",
  "longDescription": "No good deed goes unpunished, {COMMANDER.FirstName}. Not ever.",
  "salvagePotential": 16,
  "maxNumberOfPlayerUnits": 4,
