  "dialogueList": [
    {
      "dialogue": {
        "EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
      },
      "name": "Dialogue_MissionStart",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "They are around here somewhere. Let's run these traitors into the ground.",
          "selectedCastDefId": "castDef_FP_PirateQueen",
          "audioName": "NONE"
        },
        {
          "words": "I would say send them to Davy Jones, however we're on land.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "d9a28c08-abdb-42bb-a140-ad3927d1f8cf"
        },
        {
          "words": "Sorry, not as funny as I thought it would be.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "d3d75b1e-ace5-43e8-b037-79a2dd2b3d4e"
        },
        {
          "words": "I will show you something funny. Where you can mount a mainsail!",
          "selectedCastDefId": "castDef_FP_PirateQueen",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
      },
      "name": "Dialogue_MissionSuccess",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Someone has to know where Sybil is holing up. Guess no one here knows. I heard where another group of her cronies are hiding.",
          "selectedCastDefId": "castDef_FP_PirateQueen",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
      },
      "name": "Dialogue_MissionFailure",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Are you that incompetent?!? Wait, don't answer that. It would just confirm my thoughts.",
          "selectedCastDefId": "castDef_FP_PirateQueen",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "33166b96-5af2-4724-b970-7884ec41ffd0"
      },
      "name": "Dialogue_AmbushWarning",
      "overrideDialogueBucketId": "DialogBucketDef_Universal_HostilesInbound",
      "dialogueContent": [
        {
          "words": "A primary target is damaged, Commander! Keep it up!",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    }
  ],
