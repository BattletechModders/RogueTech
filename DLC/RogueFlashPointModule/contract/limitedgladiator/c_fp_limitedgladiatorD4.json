  "dialogueList": [
    {
      "dialogue": {
        "EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
      },
      "name": "Dialogue_MissionStart",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "I can't help it if my fans admire me so much and want to partake. This isn't a feeling you're familiar with is it?",
          "selectedCastDefId": "castDef_SE01_CommVoice01",
          "audioName": "NONE"
        },
        {
          "words": " Commander {COMMANDER.LastName}, our viewers are losing their minds! Don't back down!",
          "selectedCastDefId": "castDef_LocalsDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "d9a28c08-abdb-42bb-a140-ad3927d1f8cf"
        },
        {
          "words": "Have any of you slept with a Mechwarrior? How about a distinguished gladiator? Kill the interloper and you'll have a chance!",
          "selectedCastDefId": "castDef_SE01_CommVoice01",
          "audioName": "NONE",
          "cameraFocusGuid": "d9a28c08-abdb-42bb-a140-ad3927d1f8cf"
        },
        {
          "words": "Be careful, Commander.",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE"
        },
        {
          "words": "Those fans are out for blood.",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
      },
      "name": "Dialogue_MissionSuccess",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "You'll be hearing from the Appeals Board about this travesty. You will not have the last word in this!",
          "selectedCastDefId": "castDef_SE01_CommVoice01",
          "audioName": "NONE"
        },
        {
          "words": "Is he for real?",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE"
        },
        {
          "words": "You've got a career in the arena, Commander. Call us if merc work doesn't pay enough.",
          "selectedCastDefId": "castDef_LocalsDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
      },
      "name": "Dialogue_MissionFailure",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "The outcome was foregone. I merely carried out the inevitable.",
          "selectedCastDefId": "castDef_SE01_CommVoice01",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "33166b96-5af2-4724-b970-7884ec41ffd0"
      },
      "name": "Dialogue_AmbushWarning",
      "overrideDialogueBucketId": "DialogBucketDef_Universal_HostilesInbound",
      "dialogueContent": [
        {
          "words": "A primary target is damaged, Commander! Keep it up!",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    }
  ],
