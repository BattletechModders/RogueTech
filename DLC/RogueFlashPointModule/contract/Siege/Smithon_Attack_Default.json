  "dialogueList": [
    {
      "dialogue": {
        "EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
      },
      "name": "MissionStartDialogue_Attack",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "The bulk of our Employer's army is entrenched in the capital, exchanging fire with what's left of the target's defense force. The battle is leaning in our Employer's favor, but they're running low on ammunition. This is where we come in.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "The structure before you is a munitions dump that the target stole from our Employer. we need to take it back. Find all hostile units and eliminate them; combat support staff will handle the rest.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "4dd1de9e-6d13-4f53-a0cc-0c21085fbc6d"
        },
        {
          "words": "I've highlighted several optional objectives for you on this mission, Commander. Saving some of the ammunition that's already packaged for transport will earn us a bonus payment. If we manage to preserve the bulk of the ammunition, we will receive a second, cumulative payment. Finally, We will receive a bounty for any Target transports we manage to destroy during the engagement.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "2c9b445c-fdeb-4d3b-a80a-dee51ced1ffb",
          "cameraDistance": "Close"
        },
        {
          "words": "The facility is heavily guarded, and if any of those munitions crates come under fire, the resulting explosion will deal heavy damage to anything caught in the blast. This includes target units.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
      },
      "name": "MissionSuccessDialogue",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Good job, Commander. With the supplies you've just secured for our Employer, his BattleMechs will shatter the target's battle lines.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "Let's get our pay and get off this world, shall we?",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE"
        },
        {
          "words": "Agreed.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
      },
      "name": "MissionFailureDialogue",
      "overrideDialogueBucketId": "",
      "dialogueContent": []
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "a223d902-cc11-4ce9-b103-9b4ceaa9762e"
      },
      "name": "Async_PostIntro_Attack",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Good hunting, Commander. Take out those BattleMechs, and mind the crates.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "rm050_110_kamea"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "f22dc04c-a65b-418c-ab59-21b037d9b311"
      },
      "name": "Async_DirectorateBaseCommander",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Looks like the target has noticed us.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "rm050_120_enemy_base_commander01"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "43e41abc-adfe-4484-bd8c-171ef415a73d"
      },
      "name": "Async_HalfDefendersDown",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "That's half of their fighting force.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "rm050_130_kamea"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4557bf44-6154-4cba-ab5e-4510e8981f89"
      },
      "name": "Async_AmmoCrateDestroyed",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Munitions crate destroyed.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "rm050_140_kamea"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "a5b0435e-7bf9-4c53-a7ee-09ebc18cca9e"
      },
      "name": "Async_OneDefenderLeft",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "There's only one target left.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "rm050_150_kamea"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "40eb0a99-5f88-4285-b712-5edb3f9f7d7c"
      },
      "name": "Async_TransportEscaped",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "An enemy transport has escaped.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "rm050_160_kamea",
          "cameraFocusGuid": "ebb40c29-9f14-4e05-ae0d-4847a65da576",
          "cameraDistance": "Medium",
          "revealRadius": 100
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "28bec7a1-a2be-4adc-9516-dc0028894e57"
      },
      "name": "Async_FirstAmmoThresholdFailed",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Losing crates will effect our pay.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "rm050_170_kamea"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "96159274-abe9-473e-a69e-a5dd2b36b8fc"
      },
      "name": "Async_SecondAmmoThresholdFailed",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Well, there goes our bonus. Ignore the crates and focus on the enemy.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "rm050_180_kamea"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "45668aee-a295-40ae-9883-d4f50829e5ea"
      },
      "name": "Inter_Transport1Flees",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "That supply truck is running with a full load of ammunition. Try and intercept it.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "0b04b20a-b835-436b-aaaa-3683d3be13ce",
          "cameraDistance": "Medium",
          "revealRadius": 100
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "81b052aa-fda1-4931-855c-2630d7fb63b4"
      },
