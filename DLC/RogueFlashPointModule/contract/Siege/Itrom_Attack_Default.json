  "dialogueList": [
    {
      "dialogue": {
        "EncounterObjectGuid": "a7679ca6-cdd4-4459-a5c4-9e02e217e847"
      },
      "name": "Async_PostIntro",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Capturing more than one silo will help turn the tide for our employer, though even one will help...",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "rm030_110_kamea"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "83e6a053-25d5-48d0-9b4e-0b9eb964527e"
      },
      "name": "Inter_ContactEstablished",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Instruments are next to useless with this much interference. You will have to rely on your own eyesight and being up close and personal with the enemies to get target locks.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "5fe194e9-5b24-4eef-9d47-869935ae83d3"
      },
      "name": "Async_PostContactEstablished",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "We should be next to invisible on approach, Commander. Try and use this to our advantage.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "rm030_120_kamea"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4d65ebca-1e25-4168-b7b7-1b6b5b234dff"
      },
      "name": "Async_CenterBaseFirstUnlocked",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "With the resources secure we are done here. Time to get paid.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "rm030_130_kamea",
          "cameraFocusGuid": "baf69f5d-4a76-42c9-9f6a-d11f64db2c49",
          "cameraDistance": "Medium",
          "cameraHeight": "High",
          "revealRadius": 100
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "fcc55d8c-b3c8-4b89-92f5-2f0eb64734bb"
      },
      "name": "Inter_FirstTankJustCaptured",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Recovery teams moving in Commander.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "3a86c5d7-563a-438d-8dce-4c8cd62938d2"
      },
      "name": "Async_SingleBaseProximityWarning",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Don't get too close. If you can see them clearly, they can most likely see you.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "rm030_140_kamea"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "35a0cd52-21ca-4ef0-851a-3347dbeabc37"
      },
      "name": "Async_BravoUnitSeesYou",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Lock and load, we've got company!",
          "selectedCastDefId": "castDef_LocalsDefault",
          "audioName": "rm030_150_enemy_pilot01"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "370744be-e487-4793-8bb8-a409490785f5"
      },
      "name": "Inter_BaseBravoAlerted",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Silo Bravo has detected you. Be prepared for trouble.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "31175198-1332-4593-b47d-6f7aa5a5e441"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "bc9c03b3-56de-450d-b9fb-95ebd3b0a0e5"
      },
      "name": "Async_AlphaUnitSeesYou",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Alpha Lance, I've got eyes on the enemy!",
          "selectedCastDefId": "castDef_LocalsDefault",
          "audioName": "rm030_160_enemy_pilot02"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4ea79923-b501-42ed-8adc-3d07c8dd3dad"
      },
      "name": "Inter_BaseAlphaAlerted",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Silo Alpha has detected your presence. If you give them enough time, they'll set the silo to self-destruct.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "65ffab5f-57ca-4e2a-ae26-3864c359ee2e"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "b1022188-7a42-43ee-98ff-dccc7ad92c6d"
      },
      "name": "Async_CharlieUnitSeesYou",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Weapons hot, Charlie Lance! We've got incoming BattleMechs at my position!",
          "selectedCastDefId": "castDef_LocalsDefault",
          "audioName": "rm030_170_enemy_pilot03"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "f7d4cc64-5943-4835-99c9-8f5c3d7c9c32"
      },
      "name": "Inter_BaseCharlieAlerted",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Silo Charlie is under alert. Take it quickly, before they have time to destroy it.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "6f0b636e-d593-4c83-ad83-dedc61f835ec"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "622a312d-8d0e-493a-8f14-8a0cb33beacc"
      },
      "name": "Async_OneRoundLeft_Depricated",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "They have nearly finished wiring the silo to blow!",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "rm030_180_kamea"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "a51da118-e7e5-43e9-947c-09b5fcca3f8b"
      },
      "name": "Async_TooLate",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Consider this silo lost.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "rm030_190_kamea"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d13647d6-187d-4810-8b4f-87fdf7681be1"
      },
      "name": "Inter_ReinforcementsArrived",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Commander, I'm detecting Directorate reinforcements between you and the evac point. You may have a fight on your hands.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "a8586e15-5070-4f23-8cab-a3dd738d41f5"
      },
      "name": "Inter_AlphaOneRoundToBlow",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "They've almost finished rigging that silo to blow.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "65ffab5f-57ca-4e2a-ae26-3864c359ee2e",
          "cameraDistance": "Medium",
          "cameraHeight": "High"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "534fca16-f686-4044-b0a6-2dcffe2955e3"
      },
      "name": "Inter_BravoOneRoundToBlow",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "We're out of time. Try and get clear quickly.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "31175198-1332-4593-b47d-6f7aa5a5e441",
          "cameraDistance": "Medium",
          "cameraHeight": "High"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "0ea928bd-5579-4b20-8eac-032e2a72c587"
      },
      "name": "Inter_CharlieOneRoundToBlow",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "That silo is almost ready to blow!",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "6f0b636e-d593-4c83-ad83-dedc61f835ec",
          "cameraDistance": "Medium",
          "cameraHeight": "High"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "53a52219-5856-48ab-a06b-7216736d19b4"
      },
      "name": "Inter_AlphaEngineersDefuse",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "We have boots on the ground, let's get those explosives defused",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "65ffab5f-57ca-4e2a-ae26-3864c359ee2e",
          "cameraDistance": "Medium",
          "cameraHeight": "High"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "7740ca96-9573-46dc-93c1-4999a9c75598"
      },
      "name": "Inter_BravoEngineersDefuse",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "We've set down Combat Engineers and they're securing the structure.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "31175198-1332-4593-b47d-6f7aa5a5e441",
          "cameraDistance": "Medium",
          "cameraHeight": "High"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "edead690-0a9c-4c27-990f-fc43bd6bd9d4"
      },
      "name": "Inter_CharlieEngineersDefuse",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Explosive defusal is a go, Commander {COMMANDER.LastName}.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "6f0b636e-d593-4c83-ad83-dedc61f835ec",
          "cameraDistance": "Medium",
          "cameraHeight": "High"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "50880b34-383d-4def-9783-ac77afcde247"
      },
      "name": "MissionSuccessDialogue_WithAutoComplete",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Good work, Commander! Our employer will be happy.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "We need to get these 'Mechs hosed down and decontaminated. C'mon, Commander… Yang's got a great big tub of boron, and he's just dying to use it.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        },
        {
          "words": "Commander, the area has been cleared. Darius has given me the green light to land immediately. Hold position.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
      },
      "name": "MissionStartDialogue",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Welcome to the badlands, Commander. The sands of this desert are rich in exotic elements that play havoc with electronic sensors and communications.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "The badlands are a gold mine of rare-earth metals and fissile materials. The enemy has seized control of our employer's largest processor and refinery, and they're getting ready to move a year's supply of exotic materials offworld.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraDistance": "Close",
          "cameraHeight": "Low"
        },
        {
          "words": "We need to capture at least one of those silos for the Restoration.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "65ffab5f-57ca-4e2a-ae26-3864c359ee2e",
          "cameraDistance": "Medium",
          "cameraHeight": "High"
        },
        {
          "words": "The radiation is interfering with enemy long-range communications.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "31175198-1332-4593-b47d-6f7aa5a5e441",
          "cameraDistance": "Medium",
          "cameraHeight": "High"
        },
        {
          "words": "If we can pick off one at a time, we should have an easier time of things.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "6f0b636e-d593-4c83-ad83-dedc61f835ec",
          "cameraDistance": "Medium",
          "cameraHeight": "High"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
      },
      "name": "MissionSuccessDialogue",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Good work, Commander. The target has suffered a major setback, and our employer has gained a valuable new asset.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "We need to get these 'Mechs hosed down and decontaminated.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
      },
      "name": "MissionFailureDialogue",
      "overrideDialogueBucketId": "",
      "dialogueContent": []
    }
  ],
