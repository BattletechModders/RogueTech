  "dialogueList": [
    {
      "dialogue": {
        "EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
      },
      "name": "Dialogue_MissionStart",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Captain Magorian's safe house is just ahead of you, Commander. Defenses should be light. That said, there'll probably be <i>some</i> armed resistance, so be ready to brush it aside.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "When the AO is clear, you'll need to rush the safe house, grab Captain Magorian…",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "a85da736-7a2e-4cc6-aff3-feb9d73fc7e1"
        },
        {
          "words": "…and then make your way back out to the LZ.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "eba2ec63-eab0-4801-b1c5-90964855a7ca"
        },
        {
          "words": "////My drones have already engaged the Baumann Group's armory, Mr. Oliveira. It is in my nature to fulfill my promises.////",
          "selectedCastDefId": "castDef_HM_SLDFCompDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "76b654a6-4f2c-4a6f-86e6-d4cf868335fe"
        },
        {
          "words": "Yeah, we'll see. May as well get to it, Commander. I'll be ready and waiting to fetch you when the deed is done.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
      },
      "name": "Dialogue_MissionSuccess",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "That's done it, Commander. We have Captain Magorian, and we are a go for evac.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        },
        {
          "words": "What about Baumann? Is his JumpShip still up there?",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "Negative, XO. He's long gone.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        },
        {
          "words": "Then our job here is done. Dr. Murad, get the Moderbjörn its computer access—codes, files, whatever it needs. Everyone else: let's move Captain Magorian onto the Leopard. We're getting the hell out of here.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
      },
      "name": "Dialogue_MissionFailure",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "////Our mission has failed, Commander. Salvage what you can and go. I will seek out the information I need on my own.////",
          "selectedCastDefId": "castDef_HM_SLDFCompDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "bcbee1e2-4d86-4ddb-89ec-c59295cae62d"
      },
      "name": "Dialogue_Interrupt_OccupyRegionStarted",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "That's it, Commander. Just hold position there for a moment, and we'll be good to go.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "We're getting a tight-beam communication from a nearby JumpShip, Commander. I'm putting it through.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        },
        {
          "words": "{COMMANDER.LastName}. Commander of {COMPANY.CompanyName}.\r\n\r\nThat's good. Now I have a face to associate with the name. And your name has become quite familiar to me of late.",
          "selectedCastDefId": "castDef_HM_CrimeBossDefault",
          "audioName": "NONE"
        },
        {
          "words": "Calling to parley, Baumann? If you want to finish this without further bloodshed, we'd be willing to negotiate.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "I'm no great lover of bloodshed, Mr. Oliveira. But neither am I squeamish about its necessity.\r\n\r\nWhen my mercenaries are finished with you, I'll see that you're given a proper burial. A sign of respect from one businessperson to another.",
          "selectedCastDefId": "castDef_HM_CrimeBossDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "9d5b076d-c29f-4d82-ae0c-8ff57b0af60e"
      },
      "name": "Dialogue_RecoveringUnitDamaged1",
      "overrideDialogueBucketId": "DialogBucketDef_Rescue_AssetUnderFire",
      "dialogueContent": [
        {
          "words": "[GENERIC VO] The asset is sustaining damage, Commander!",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "62f3ce2e-81e0-4082-952c-63d174c82d96"
      },
      "name": "Dialogue_RecoveringUnitDamaged2",
      "overrideDialogueBucketId": "DialogBucketDef_Rescue_AssetUnderFire-Sec",
      "dialogueContent": [
        {
          "words": "[GENERIC VO] The secondary asset is sustaining damage, Commander!",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "5cfa1621-2a66-4321-a749-9649c9632db0"
      },
      "name": "Dialogue_RecoveredTarget1",
      "overrideDialogueBucketId": "DialogBucketDef_Rescue_AssetInHand",
      "dialogueContent": [
        {
          "words": "[GENERIC VO] The asset has been recovered, Commander. Good work. ",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "8b2c266f-ac37-4f07-acd2-290228af6e04"
      },
      "name": "Dialogue_RecoveredTarget2",
      "overrideDialogueBucketId": "DialogBucketDef_Rescue_AssetInHand-Sec",
      "dialogueContent": [
        {
          "words": "[GENERIC VO] The secondary asset has been recovered, Commander.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "fdf5b937-45a0-4448-a0ba-03f8df083863"
      },
      "name": "Dialogue_Interrupt_RecoveringUnitDestroyed2",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "NYI",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    }
  ],
