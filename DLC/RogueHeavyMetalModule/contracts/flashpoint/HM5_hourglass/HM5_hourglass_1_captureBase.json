  "dialogueList": [
    {
      "dialogue": {
        "EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
      },
      "name": "Dialogue_MissionStart",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Okay, Commander, I've set our lance down just outside the Baumann Group's visual range.\r\n\r\nDefenses will probably run on the heavy side, so I'd recommend approaching with caution.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        },
        {
          "words": "Yes, but not <i>too</i> much caution. We need to take the facility stat, so the Moderbjörn can lock down the <i>Dobrev</i>'s docking clamps.\r\n\r\nThis mission won't count for much if the ship runs off again.",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE"
        },
        {
          "words": "Don't worry, Doc. We won't leave Momma Bear hanging, and we won't let the <i>Dobrev</i> escape. We can't—the rest of our mystery 'Mech is hidden away on that ship.",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE"
        },
        {
          "words": "That's the theory, and we're going to investigate it. But first, we engage the clamps.\r\n\r\nYou know what to do, Commander. I'll leave you to it.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
      },
      "name": "Dialogue_MissionSuccess",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "That's done it, Commander! I've gained access to the complex's computers and transferred control to the Moderbjörn.",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE"
        },
        {
          "words": "////Thank you, Doctor. I have deactivated the spaceport's turrets and engaged the spaceport's docking clamps. The <i>Dobrev</i> won't be going anywhere without my permission.////",
          "selectedCastDefId": "castDef_HM_SLDFCompDefault",
          "audioName": "NONE"
        },
        {
          "words": "Hang on a second. I'm getting a comm message over an unknown channel. Baumann again, I'm sure, but… wait. Motherf—\r\n\r\nThis can't be happening. It just… <i>can't</i>!",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        },
        {
          "words": "What is it, Meyer? Who do you have on the line?",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "The goddamned [[DM.BaseDescriptionDefs[LoreBlackWidow],Black Widow]], that's who!\r\n\r\nDid I miss something, Commander? When did our search for the <i>Dobrev</i> turn into a meet-and-greet with Natasha-effing-Kerensky?",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        },
        {
          "words": "You'd better put her through, Meyer. If there's one MechWarrior we don't wanna leave hanging, the Black Widow is it.\r\n\r\nThat goes for you too, Boss. Better get to the viewscreen, and you'd better do it now.",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
      },
      "name": "Dialogue_MissionFailure",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "////Pick up the pieces of your lance and go, Commander. Our mission has failed.////",
          "selectedCastDefId": "castDef_KuritaRepDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "692713e2-ddc8-4e4e-963b-81163f2fc598"
      },
      "name": "Dialogue_EnemiesSpotted",
      "overrideDialogueBucketId": "DialogBucketDef_Universal_HostilesInbound",
      "dialogueContent": [
        {
          "words": "Bogeys on sensors!",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "9071057f-44c7-44ee-a23e-10bc7bab3e00"
      },
      "name": "Dialogue_GoToComplete_EnemiesRemain",
      "overrideDialogueBucketId": "DialogBucketDef_CaptureBase_AreaNotClear",
      "dialogueContent": [
        {
          "words": "[GENERIC VO] Area is not clear, Commander. Eliminate the hostiles before continuing to the next Objective.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "774f075d-acb4-43d0-aeb2-607292ecd3db"
      },
      "name": "Dialogue_EnemiesComplete_GoToRemain",
      "overrideDialogueBucketId": "DialogBucketDef_CaptureBase_GoToNextObj",
      "dialogueContent": [
        {
          "words": "[GENERIC VO] Sensors are clear, proceed to the next objective.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d61f12a3-f820-4026-b7ca-9d263d1525fa"
      },
      "name": "Dialogue_Interrupt_DropshipLanding",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Leopard inbound, Commander. I'll be touching down directly.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "9193a080-418b-4e46-aeb0-f8ac55fb63b5"
      },
      "name": "Dialogue_Interrupt_TurretWarning",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "PLACEHOLDER",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "9a1bfa77-fc82-4e20-be61-63ebe1d1949e"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "37173dfd-65d9-40dc-b498-906086595931"
      },
      "name": "Dialogue_Interrupt_GoToComplete",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "I've got eyes on the security complex, Commander. Take it, and we'll get this show on the road.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "a85da736-7a2e-4cc6-aff3-feb9d73fc7e1"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "Dialogue_BaseReached"
      },
      "name": "Dialogue_BaseReached",
      "dialogueContent": [
        {
          "words": "INCOMING TRANSMISSION.",
          "selectedCastDefId": "castDef_Computer",
          "audioName": "NONE"
        },
        {
          "words": "You're quite persistent, Commander {COMMANDER.LastName}.\r\n\r\nLike a bad rash, I just can't seem to get rid of you.",
          "selectedCastDefId": "castDef_HM_CrimeBossDefault",
          "audioName": "NONE"
        },
        {
          "words": "I could crack the obvious joke about that, but it's just too easy.",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE"
        },
        {
          "words": "What's coming for you is no laughing matter. I've hired a new strike team, Commander. They'll keep you company while my ground crew prepares the <i>Dobrev</i> for departure.",
          "selectedCastDefId": "castDef_HM_CrimeBossDefault",
          "audioName": "NONE"
        },
        {
          "words": "We've got new heat signatures, Commander! Incoming 'Mechs, assault-class!",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        },
        {
          "words": "Get on it, Commander, and take 'em out quick. We need to seize that security complex before the <i>Dobrev</i> is cleared to launch.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    }
  ],
