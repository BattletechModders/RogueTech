  "chunkList": [],
  "dialogueList": [
    {
      "dialogue": {
        "EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
      },
      "name": "Dialogue_MissionStart",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Uh... Commander, we've got another dropship on approach. Close. Just set down a lance maybe a klick out. Not hostile. Not talking either.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        },
        {
          "words": "What? That wasn't in the op briefing. Are they local security? Mercs?",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "Negative. No transponder, no ID beacons, just... landed and powered up like they belong here.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        },
        {
          "words": "I'm pulling sensor data now. Their mechs... it's Clan-era tech, no doubt, but odd. Configurations don't match any known TO&E I've seen. Some SLDF components too, but modified. Like someone's been tinkering with relics they shouldn't have.",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE"
        },
        {
          "words": "Yeah, I'm seein' 'em on the feed. That ain't right. Those machines look like ghosts. Half Star League, half Clan, and all wrong. Gives me the damn chills.",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE"
        },
        {
          "words": "If they're not hostile, they're probably friendly… but I don't like being surprised mid-drop. Stay sharp.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "No kidding. I'll keep an eye on them. If they twitch wrong, we'll know before they blink.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
      },
      "name": "Dialogue_MissionSuccess",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Heads up, Commander. Our \"friends\" are sweeping the wreckage. They're torching everything they're not taking. No comms, just moving fast.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        },
        {
          "words": "Figures. We do the job, they grab the prize and vanish. This whole op feels like a setup.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "That wasn't salvage work. They knew exactly what to pull, and they didn't want anyone else digging through the scraps.",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE"
        },
        {
          "words": "Whoever they are, they planned this down to the second. We were just one more moving part.",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE"
        },
        {
          "words": "Let's hope that's the end of it. No more mystery jobs, no more ghost lances... but I've got a bad feeling we're not done yet.",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
      },
      "name": "Dialogue_MissionFailure",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Damn it. This op was a mess from the start. No comms from our so-called allies, no coordination, just silence. Hard to pull off a clean mission when half the team won't even talk. We never had a real chance.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "2bc99c34-b9a1-4e6d-ad33-a64162819bd0"
      },
      "name": "Dialogue_GoToComplete",
      "overrideDialogueBucketId": null,
      "dialogueContent": [
        {
          "words": "Alright, we've got eyes on the convoy. If everything goes to plan, this should be in and out. Clean and fast. Just once, I'd like one of these shady gigs to actually go smooth. Fingers crossed.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "7cd7f943-20e7-4b74-9a3c-e1d0cfc30fd9"
      },
      "name": "Dialogue_ConvoyDamaged",
      "overrideDialogueBucketId": null,
      "dialogueContent": [
        {
          "words": "There it is! First shot's landed. Let's keep it tight and quiet, don't want those reinforcements showing up early.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "a50ad243-225a-4beb-9317-d7aeffa2bcdc"
      },
      "name": "Dialogue_Interrupt_GuardsDestroyed",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Escorts are down. Smooth work, team. Let's keep this momentum, but stay alert.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "793629ec-2233-4559-988b-460c5fdf6d58"
      },
      "name": "Dialogue_Interrupt_ConvoyReachedExtraction",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "They're trying to pull out fast! No time to waste. Cut them off now, and don't let them slip away!",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "366443c6-7895-4b4c-aea9-544f1a88c43e"
      },
      "name": "Dialogue_ConvoyTargetDestroyed",
      "overrideDialogueBucketId": null,
      "dialogueContent": [
        {
          "words": "Good work, Commander. First target down. Let's keep the pressure on and finish this clean.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "865db024-27b0-4c03-90d6-f257329c5d69"
      },
      "name": "Dialogue_EscapeInstruction",
      "overrideDialogueBucketId": null,
      "dialogueContent": [
        {
          "words": "All convoy targets are down. Let's wrap this up and get out clean.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "22fbc109-89c1-4590-bd94-f2f58e53504f"
      },
      "name": "Dialogue_ReinforcementWarning",
      "overrideDialogueBucketId": null,
      "dialogueContent": [
        {
          "words": "Hold up! Enemy reinforcements just showed up on long range sensors. Stay sharp and adjust your positions!",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        }
      ]
    }
  ],
