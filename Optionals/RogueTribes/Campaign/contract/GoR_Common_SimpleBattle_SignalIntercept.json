  "dialogueList": [
    {
      "dialogue": {
        "EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
      },
      "name": "Dialogue_MissionStart",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Coming in low. Visual contact confirmed. Multiple hostiles on the ridgeline. And… yeah, some of those chassis are the same refitted types we've been tracking.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        },
        {
          "words": "I'm reading weapon profiles I don't recognize. Energy spikes are off-pattern. These aren't standard loadouts",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE"
        },
        {
          "words": "Great. First they bring back the Wolverines, now they're arming them with mystery tech. That's just what we need.",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE"
        },
        {
          "words": "Stay sharp. If we don't know what they're packing, we treat everything like it bites hard.",
          "selectedCastDefId": "castDef_Commander",
          "audioName": "NONE"
        },
        {
          "words": "Copy that. Unknown weapons, unknown rules. Let's not be the ones writing the cautionary tale today.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
      },
      "name": "Dialogue_MissionSuccess",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Mission's a success. We got what we came for, and more. Those weapons they used were like nothing I've seen before. With any luck, Jorgensson's techs can pull something useful from the wreckage.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
      },
      "name": "Dialogue_MissionFailure",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "That was a disaster. We didn't just lose, we got dismantled. Whatever those things were firing, we weren't even close to ready for it. No salvage, no leads… just wreckage and regret.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "33166b96-5af2-4724-b970-7884ec41ffd0"
      },
      "name": "Dialogue_AmbushWarning",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Hold up! New signals just lit up on the far ridge! Multiple fast movers closing in. It's an ambush, get ready!",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        }
      ]
    }
  ],
