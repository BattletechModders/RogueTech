  "dialogueList": [
    {
      "dialogue": {
        "EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
      },
      "name": "Dialog_MissionStart",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "All units to defensive positions. The facility is ours for now, but that situation will change the moment Joanna realizes what we are doing here.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "Dr. Tilsaye just arrived at the archive terminal and the download has begun. She needs forty minutes minimum for complete extraction. The system is running nominal so far.",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE"
        },
        {
          "words": "Long-range sensors are detecting movement. Multiple contacts inbound from the northern approach vector. Joanna's forces are already moving to intercept us.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        },
        {
          "words": "Commander! You have to make sure most of the base stays functional or I will lose access to key systems needed for the data extraction.",
          "selectedCastDefId": "castDef_AnikaTilsaye",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
      },
      "name": "Dialog_MissionSuccess",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "We are clear. All hostiles are neutralized or withdrawn. Dr. Tilsaye is secure and the perimeter is stable.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "Perfect timing. The full archive is secured and verified. Complete documentation from project inception through current status.",
          "selectedCastDefId": "castDef_AnikaTilsaye",
          "audioName": "NONE"
        },
        {
          "words": "We should not still be standing here when Joanna works out exactly what just left this facility with us. Extract immediately.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
      },
      "name": "Dialog_MissionFailure",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "We could not hold long enough. Enemy forces are breaching the perimeter and we are taking too much damage to sustain the defense.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "The download was interrupted before completion. We need to pull back now before we lose more than just the archive. It is not lost permanently, but Joanna knows we tried and she will reinforce this location.",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "37095331-664a-4ccd-b09a-8693f0ea6653"
      },
      "name": "Dialogue_Interrupt_CapturedTurrets",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Turrets are live and tracking! Let's make them regret coming.",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d7184f62-0021-41af-a5a4-34a585aa9d39"
      },
      "name": "Dialogue_ReinforcementWarning",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "New drop signature detected. Multiple contacts inbound. Joanna is committing reinforcements to the engagement.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        },
        {
          "words": "She is not letting this archive go quietly. We knew she would not. Stay focused and keep them away from the facility interior.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d382339d-0cc4-483f-b64d-4a93f3009f7e"
      },
      "name": "Dialogue_BuildingDamaged",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "We've got damage on one of the core systems! Don't let them any closer!",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "56262d64-510a-45a1-9a7a-cdadd02a27ec"
      },
      "name": "Dialogue_BuildingDestroyed",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "We lost a critical system! Data extraction is still going, but has slowed down.",
          "selectedCastDefId": "castDef_AnikaTilsaye",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "6830c98e-266c-4185-9358-41aef95b471d"
      },
      "name": "Dialogue_Interrupt_OneBuildingLeft",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Commander, the data extraction has almost stopped. If we lose another building there won't be any way to get the information out!",
          "selectedCastDefId": "castDef_AnikaTilsaye",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "04aca727-601c-4fea-9f14-9cbef76768b3"
      },
      "name": "Dialogue_HalfwayAlert",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "We are halfway there, keep protecting the buildings!",
          "selectedCastDefId": "castDef_AnikaTilsaye",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "f2f3007e-6680-4656-a3cf-1f5376c2377a"
      },
      "name": "Dialogue_Interrupt_TurretBriefing",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "The base has some shut down turrets ready to spin online if you can manage to get our engineers to them.",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE"
        }
      ]
    }
  ],
