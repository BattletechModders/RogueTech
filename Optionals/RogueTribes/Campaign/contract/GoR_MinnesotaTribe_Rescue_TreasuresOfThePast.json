  "dialogueList": [
    {
      "dialogue": {
        "EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
      },
      "name": "Dialogue_MissionStart",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Alright, we're inbound. The dig site should be just ahead. If those Watch units get there first, the past goes up in smoke.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "No luck there, sensors show forces already at the site. Prepare for combat.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "9a1bfa77-fc82-4e20-be61-63ebe1d1949e"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
      },
      "name": "Dialogue_MissionSuccess",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Artifacts secured, enemy scattered. The Tribe's technicians are gonna love this. Old tech, fresh use.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
      },
      "name": "Dialogue_MissionFailure",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Damn it, we lost the site. Whatever was buried there... it's gone now. Wiped from history all over again.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "bcbee1e2-4d86-4ddb-89ec-c59295cae62d"
      },
      "name": "Dialogue_Interrupt_OccupyRegionStarted",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "We're at the dig. Sensors show intact hardware, still drawing faint power. Starting extraction now.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "a85da736-7a2e-4cc6-aff3-feb9d73fc7e1"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "9d5b076d-c29f-4d82-ae0c-8ff57b0af60e"
      },
      "name": "Dialogue_RecoveringUnitDamaged1",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Watch that unit! They've got the payload. Lose them, and this mission's dust.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "5cfa1621-2a66-4321-a749-9649c9632db0"
      },
      "name": "Dialogue_RecoveredTarget1",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Commander, artifacts are safely aboard and stable.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    }
  ],
