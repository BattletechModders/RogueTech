  "Description": {
    "Cost": 3592790,
    "UIName": "Hiisi",
    "Id": "chassisdef_hiisi_HII-3",
    "Name": "Hiisi",
    "Details": "Hiisi 3 carries a diverse arsenal: a Flechette 20 for versatile electromagnetic attacks, a Hyper PPC and Snub-Nose PPC both enhanced with TEMPEST manifolds to boost plasma weapon output, a Mech-Scale Grenade Launcher for area suppression, plus an Improved Large Laser and Early Clan Extended Range Medium and Small Lasers for reliable energy support. Equipped with the PHI Suite for shared targeting data within the lance, Hiisi 3 excels in flexible multi-role combat, balancing precision, heavy firepower, and indirect fire capabilities.\n\n<b><color=#e62e00>Quirk: Intimidating</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.4</color></b>",
    "Icon": "uixTxrIcon_Hiisi"
  },
