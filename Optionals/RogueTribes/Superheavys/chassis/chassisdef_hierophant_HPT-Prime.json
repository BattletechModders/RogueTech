  "Description": {
    "Cost": 17728495,
    "UIName": "Hierophant",
    "Id": "chassisdef_hierophant_HPT-Prime",
    "Name": "Hierophant",
    "Details": "As the original loadout of the Hierophant, the Prime configuration was initially a test platform for TEMPEST and Ares attachments. It features 2 Hyper PPCs with TEMPEST, 2 i-AC/10s with Ares TPS, and a flamer equipped with TEMPEST, though the flamer’s extremely short range rendered it practically useless in combat, serving only to verify TEMPEST compatibility. The inclusion of AMS Mk2 rounds out the build. Its strong performance led to expanded Hierophant production and inspired the diverse loadouts that followed, cementing its role as the Minnesota Tribe’s premier superheavy command ‘Mech.\n\n<b><color=#e62e00>Quirk: Accurate Weapon - Energy</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.45</color></b>\n\n<color=#FFEF00>Arm Actuator Limits: Omni</color>",
    "Icon": "uixTxrIcon_Hierophant"
  },
  "VariantName": "HPT-Prime",
