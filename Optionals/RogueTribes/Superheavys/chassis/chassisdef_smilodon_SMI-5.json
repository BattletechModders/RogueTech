  "Description": {
    "Cost": 2817879,
    "UIName": "Smilodon",
    "Id": "chassisdef_smilodon_SMI-5",
    "Name": "Smilodon",
    "Details": "The Smilodon 5 is a specialized plasma-based assault variant built around a Magnothermic Plasma Engine, enabling aggressive thermal channeling. It features two Compact PPCs and four Ion Stream Projectors, all equipped with TEMPEST, advanced plasma energy synchronization manifolds that amplify both kinetic and thermal discharge. Optimized for brutal close-to-mid range combat, the Smilodon 5 delivers overwhelming plasma saturation at the cost of extreme heat buildup. The PHI Suite enables coordinated targeting across the lance, reinforcing its role as a high-intensity frontline brawler.\n\n<b><color=#e62e00>Quirk: Accurate Weapon - PPC</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.32</color></b>\n\n<color=#FFEF00>Arm Actuator Limits: Left Upper, Right Upper</color>",
    "Icon": "uixTxrIcon_smilodon"
  },
