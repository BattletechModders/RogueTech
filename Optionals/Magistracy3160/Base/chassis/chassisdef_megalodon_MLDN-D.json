  "Description": {
    "Cost": 3832137,
    "UIName": "Megalodon",
    "Id": "chassisdef_megalodon_MLDN-D",
    "Name": "Megalodon",
    "Details": "The D configuration is the most eclectic of the Megalodon variants, pairing a Sniper Cannon with an LRM 20, SRM 6 and ER Small Laser across widely different range brackets. A Watchdog CEWS adds strong electronic warfare coverage to an already versatile platform. The combination demands an adaptable pilot willing to manage multiple weapon systems simultaneously rather than focusing on any single engagement range.\n\n<b><color=#e62e00>Quirk: Combat Computer</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.19</color></b>",
    "Icon": "uixTxrIcon_megalodon"
  },
  "VariantName": "MLDN-D",
