  "Description": {
    "Cost": 1028686,
    "UIName": "Pixie",
    "Id": "chassisdef_pixie_PX-DM",
    "Name": "Pixie",
    "Details": "The PX-DM is the demolition kit configuration. A four-ton Wrecking Ball in the right arm serves as the primary tool for structural demolition work. A Small Laser in the left arm handles precision tasks where the Wrecking Ball would be too destructive. Full environmental sealing is standard across all Pixie configurations.\n\n<b><color=#e62e00>Quirk: Easy to Maintain</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 0.97</color></b>",
    "Icon": "uixTxrIcon_pixie"
