  "Description": {
    "Cost": 3832137,
    "UIName": "Megalodon",
    "Id": "chassisdef_megalodon_MLDN-B",
    "Name": "Megalodon",
    "Details": "The B configuration centers on a HAG/40 as its primary weapon, delivering a devastating scatter-pattern ballistic attack at range. A Large Pulse Laser and twin ER Medium Lasers provide sustained energy backup across short and medium ranges. Eighteen double heat sinks manage the combined energy load. The HAG/40 carries twelve shots, enough ammunition for a sustained engagement before resupply is needed.\n\n<b><color=#e62e00>Quirk: Combat Computer</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.19</color></b>",
    "Icon": "uixTxrIcon_megalodon"
  },
  "VariantName": "MLDN-B",
  "ChassisTags": {
    "items": [
