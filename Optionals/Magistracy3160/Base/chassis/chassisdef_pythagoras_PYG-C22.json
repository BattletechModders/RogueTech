    "Cost": 1359356,
    "UIName": "Pythagoras",
    "Id": "chassisdef_pythagoras_PYG-C22",
    "Name": "Pythagoras",
    "Details": "The PYG-C22 centers on combat rescue with a center torso Cargo Bay and Paramedic Equipment for casualty transport. A PPC in the right arm provides serious deterrent firepower while a Medium Laser and Machine Gun handle lighter threats. The left arm carries a Hatchet for debris clearing and a Flamer for area denial. Twin jump jets enable access to difficult terrain. A head-mounted Searchlight aids operations in low visibility. Heavy Industrial armor provides battlefield survivability.\n\n<b><color=#e62e00>Quirk: Improved Lifesupport</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 0.81</color></b>",
    "Icon": "uixTxrIcon_pythagoras"
  },
  "VariantName": "PYG-C22",
