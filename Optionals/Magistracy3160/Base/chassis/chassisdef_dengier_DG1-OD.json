  "Description": {
    "Cost": 4408329,
    "UIName": "Dengier",
    "Id": "chassisdef_dengier_DG1-OD",
    "Name": "Dengier",
    "Details": "The DG1-OD loadout is the Dengier at its most focused. A Gauss Rifle delivers precise long-range damage while five Medium Pulse Lasers saturate anything that gets close. The combination is deceptively simple but highly effective, covering both range brackets without any wasted tonnage. CASE II protects the Gauss Rifle and an ER Small Laser covers dead zones.\n\n<b><color=#e62e00>Quirk: Protected Actuators</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.05</color></b>",
    "Icon": "uixTxrIcon_dengier"
  },
  "VariantName": "DG1-OD",
  "ChassisTags": {
    "items": [
