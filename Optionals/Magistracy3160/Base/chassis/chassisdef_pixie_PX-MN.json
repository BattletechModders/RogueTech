  "Description": {
    "Cost": 1201820,
    "UIName": "Pixie",
    "Id": "chassisdef_pixie_PX-MN",
    "Name": "Pixie",
    "Details": "The PX-MN is the mining kit. A three-ton Mining Drill in the right arm handles primary extraction work. Twin Small Lasers in the left arm provide precision cutting capability for detailed mineral work. A Searchlight in the left torso enhances visibility in deep dark mine environments. Full environmental sealing is standard.\n\n<b><color=#e62e00>Quirk: Easy to Maintain</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 0.97</color></b>",
    "Icon": "uixTxrIcon_pixie"
  },
  "VariantName": "PX-MN",
