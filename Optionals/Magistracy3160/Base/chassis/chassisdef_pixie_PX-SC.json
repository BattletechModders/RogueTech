  "Description": {
    "Cost": 953363,
    "UIName": "Pixie",
    "Id": "chassisdef_pixie_PX-SC",
    "Name": "Pixie",
    "Details": "The PX-SC is the security kit configuration of the Pixie chassis. An SRM 2 in the right torso carries fifty rounds of smoke ammunition for crowd dispersal. Twin Light Machine Guns in the left arm default to rubber rounds for non-lethal deterrence. A Small Laser in the right arm provides lethal backup when needed. A Searchlight aids visibility during night operations. Full environmental sealing is standard across all Pixie configurations. All weapons can be reloaded with live ammunition.\n\n<b><color=#e62e00>Quirk: Easy to Maintain</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 0.97</color></b>",
    "Icon": "uixTxrIcon_pixie"
  },
  "VariantName": "PX-SC",
  "ChassisTags": {
    "items": [
      "IndustrialSquadMech",
      "Squad",
