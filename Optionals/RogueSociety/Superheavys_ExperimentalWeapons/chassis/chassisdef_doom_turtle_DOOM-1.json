  "Description": {
    "Cost": 41533982,
    "UIName": "Doom Turtle",
    "Id": "chassisdef_doom_turtle_DOOM-1",
    "Name": "Doom Turtle",
    "Details": "The Doom Turtle is an attempt at creating a mobile fortress out of a superheavy QuadMech. Designed by the brilliant but sometimes over-creative minds of the Society, it is the true pinnacle of what you can do with a QuadMech. Using a specifically designed custom Ferro-Carbide Lammellor armor ensures the Quad can take anything short of a direct nuclear hit and just shake it off. Packed with the latest weapon technologies from the Society, the Doom Turtle brings twin Heavy Gauss Rifles and MRM-60 launchers, a Small Supra Laser and a Snubnose PPC.\n\n<b><color=#e62e00>Quirk: Superheavy Prototype</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.6</color></b>",
    "Icon": "uixTxrIcon_doomturtle_v2"
  },
