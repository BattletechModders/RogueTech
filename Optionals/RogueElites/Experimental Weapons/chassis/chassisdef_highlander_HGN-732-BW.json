  "Description": {
    "Cost": 1767625,
    "UIName": "Highlander",
    "Id": "chassisdef_highlander_HGN-732-BW",
    "Name": "Highlander",
    "Details": "The Highlander-732 is one of the most well-known Star League era BattleMechs. This particular model appears to date back to the Black Watch regiment, before they were recognised as Royals. Some aftermarket modifications have been made, several of which seem to be determined to bring the dream of the \"Highlander Burial\" closer to reality.\n\n<b><color=#e62e00>Quirk: Reinforced Legs</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.2</color></b>\n\n<color=#FFEF00>Arm Actuator Limit: Right Lower</color>",
    "Icon": "uixTxrIcon_highlander"
  },
