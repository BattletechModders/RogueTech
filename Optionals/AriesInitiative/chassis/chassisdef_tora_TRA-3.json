  "Description": {
    "Cost": 1194702,
    "UIName": "Tora",
    "Id": "chassisdef_tora_TRA-3",
    "Name": "Tora",
    "Details": "The Tora 3, developed after another year of operational feedback, takes a sharp turn from its predecessor’s loadout. It mounts twin ATM-9s and a single ER PPC, giving it effective coverage at all ranges. A Targeting Computer enhances accuracy, while 120 meters of jump capability and the continued use of a Supercharger ensure strong mobility and tactical flexibility.\n\n<b><color=#e62e00>Quirk: Easy to Pilot</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.15</color></b>\n\n<color=#FFEF00>Arm Actuator Limits: Left Upper, Right Upper</color>\n\n<b><color=#0064e6>Used with permission from Aries Games and Miniatures.</color></b>",
    "Icon": "uixTxrIcon_tora"
  },
  "VariantName": "TRA-3",
