  "Description": {
    "Cost": 1227702,
    "UIName": "Tora",
    "Id": "chassisdef_tora_TRA-1",
    "Name": "Tora",
    "Details": "The Tora 1 mounts twin ER Large Lasers and ER Medium Lasers in a classic over/under design in each arm, all tied into a Targeting Computer for improved accuracy. A single ATM-9 is mounted in the torso, offering excellent battlefield flexibility through its variable munitions. One of the Tora 1’s most distinctive features is its hunched upper torso design, which not only shields it from aerial attacks but also helps protect its torso-mounted jump jets.\n\n<b><color=#e62e00>Quirk: Easy to Pilot</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.15</color></b>\n\n<color=#FFEF00>Arm Actuator Limits: Left Lower, Right Lower</color>\n\n<b><color=#0064e6>Used with permission from Aries Games and Miniatures.</color></b>",
    "Icon": "uixTxrIcon_tora"
  },
  "VariantName": "TRA-1",
