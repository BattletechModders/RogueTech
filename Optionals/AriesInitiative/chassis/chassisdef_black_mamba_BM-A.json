  "Description": {
    "Cost": 6889142,
    "UIName": "Black Mamba",
    "Id": "chassisdef_black_mamba_BM-A",
    "Name": "Black Mamba",
    "Details": "The A configuration is a precision brawler, packing twin Class 20 Hyper Assault Gauss Rifles and dual Improved Heavy Medium Lasers. All weapons are integrated with a Targeting Computer, ensuring deadly accuracy. This build is as brutal as it is reliable, capable of shredding targets with terrifying efficiency.\n\n<b><color=#e62e00>Quirk: Rugged</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.12</color></b>\n\n<b><color=#0064e6>Used with permission from Aries Games and Miniatures.</color></b>",
