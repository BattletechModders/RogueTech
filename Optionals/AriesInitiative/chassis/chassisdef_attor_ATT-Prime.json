  "Description": {
    "Cost": 7699872,
    "UIName": "Attor",
    "Id": "chassisdef_attor_ATT-Prime",
    "Name": "Attor",
    "Details": "The Attor Prime configuration carries an ER PPC, an iATM-12 launcher, and a powerful Class 30 Hyper Assault Gauss Rifle. Generous ammunition supplies enable the Attor to sustain combat longer than many other assault units, giving it excellent staying power on the battlefield during prolonged engagements.\n\n<b><color=#e62e00>Quirk: Reinforced Legs</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.17</color></b>\n\n<b><color=#0064e6>Used with permission from Aries Games and Miniatures.</color></b>",
    "Icon": "uixTxrIcon_attor"
  },
  "VariantName": "ATT-Prime",
