  "Description": {
    "Cost": 6301211,
    "UIName": "Gryphon",
    "Id": "chassisdef_gryphon_GRP-Prime",
    "Name": "Gryphon",
    "Details": "The Gryphon Prime configuration is designed to be a direct fire support platform. Dual Class 20 Hyper Assault Gauss Rifles can shred an opponent at long range, while a single ER Small Laser provides backup firepower. With five tons of HAG ammunition, the Gryphon Prime is well-equipped to maintain pressure on the battlefield.\n\n<b><color=#e62e00>Quirk: Combat Computer</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.1</color></b>\n\n<b><color=#0064e6>Used with permission from Aries Games and Miniatures.</color></b>",
    "Icon": "uixTxrIcon_gryphon"
  },
