  "Description": {
    "Cost": 6889142,
    "UIName": "Black Mamba",
    "Id": "chassisdef_black_mamba_BM-C",
    "Name": "Black Mamba",
    "Details": "The C configuration leans heavily into missile support, fielding two iATM-12 launchers, one iATM-9, and a trio of ER Medium Lasers. While launching a full alpha strike may push heat levels dangerously high, this setup is often deployed in an indirect fire role. The ER Mediums likely serve as backup when missile ammo is exhausted or in closer engagements.\n\n<b><color=#e62e00>Quirk: Rugged</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.12</color></b>\n\n<b><color=#0064e6>Used with permission from Aries Games and Miniatures.</color></b>",
    "Icon": "uixTxrIcon_blackmamba"
  },
