  "Description": {
    "Cost": 4137500,
    "UIName": "Baracas",
    "Id": "chassisdef_rogue_bear_RBR-BAB_U",
    "Name": "Baracas",
    "Details": "This was originally the personal Battle Armor of legendary Warrior Bearing Banacek, callsign 'Bearing'.  The Rogue Bear <i>'Baracas'</i> was modified by Bearing 'Bearing' Banacek after having spent time amongst Ghost Bear Dominion warriors.  He recognised the family atmosphere of the Ghost Bears was similar to the easy fraternal attitude within Star Adder.  He isolated himself to redesign the Rogue Bear Battle Armor into one he could personally use in combat. Heavily Armored, with stealth and armed with heavy VibroClaws, MicroPulse Lasers and a PPC, the Baracas is able to strike without warning.\n\n<b><color=#e62e00>Quirk: Experimental Design</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 0.935</color></b>\n\n<b><color=#2aad3b>Can mount Omni units, can melee, can not swarm.</b></color>",
    "Icon": "BA_Baracas"
  },
