  "Description": {
    "Cost": 922198,
    "UIName": "Locust",
    "Id": "chassisdef_locust_LCT-QSC",
    "Name": "Locust",
    "Details": "Introducing the Quicsell Locust – Unmatched Agility, Unrivaled Firepower! With a specially lightened structure for supreme agility, this variant carries two sets of Quicsell's pulse lasers and two heavy small chemical lasers for high stopping power. Topping it off is Quicsell's ViewMaster cockpit for the best view of the battle. The Quicsell Locust: Where agility meets firepower in style! \n\n<b><color=#e62e00>Quirk: Quicksell Clan Mech</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 0.95</color></b>\n\n<color=#FFEF00>Arm Actuator Limits: Left Upper, Right Upper</color>",
    "Icon": "uixTxrIcon_locust"
  },
