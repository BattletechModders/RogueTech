  "chunkList": [],
  "dialogueList": [
    {
      "dialogue": {
        "EncounterObjectGuid": "bf6bf190-249c-4181-9f33-bc5f9e69dcf4"
      },
      "name": "Async_ComeBackHome",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Great job, Commander. Double back to our client's platform. The sooner we can collect our pay and break orbit, the better.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "m020_060_darius",
          "revealRadius": 0
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "26127c90-1c42-4cb4-b27b-0b1b225e9233"
      },
      "name": "Inter_Betrayal",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Brilliant work, Commander. We should have no trouble mopping up at the other platforms now that their defenses are down.",
          "selectedCastDefId": "castDef_SE02_EmployerDefault",
          "audioName": "NONE",
          "revealRadius": 0
        },
        {
          "words": "We get the job done. Speaking of which—",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "revealRadius": 0
        },
        {
          "words": "I wasn't finished. These platforms won't do us much good if we can't hold them—Majesty Metals taught us that. So we're going to need your BattleMechs.",
          "selectedCastDefId": "castDef_SE02_EmployerDefault",
          "audioName": "NONE",
          "revealRadius": 0
        },
        {
          "words": "You're going to want to reconsider that.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "revealRadius": 0
        },
        {
          "words": "Why? Your lance has already been target locked by our turrets. Now, power down and surrender, and we'll let you walk. Or try to fight, and we'll tear you to shreds. Your call.",
          "selectedCastDefId": "castDef_SE02_EmployerDefault",
          "audioName": "NONE",
          "revealRadius": 0
        },
        {
          "words": "[sigh] Well, there goes our goddamned payday. Hold tight, Commander—we're on our way.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "revealRadius": 0
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "b7027bf0-8395-40cb-9ccd-83fe15de3700"
      },
      "name": "Async_Stop",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "You are trespassing on Majesty Metals and Manufacturing property, and acting in collusion with a domestic terrorist organization. Cease your advance immediately or you <i>will</i> be fired upon!",
          "selectedCastDefId": "castDef_SE02_OpForDefault",
          "audioName": "m020_050_miningcom",
          "revealRadius": 0
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4af7829b-f342-4cf8-ab40-5cc21b04dd18"
      },
      "name": "Inter_ShadowHawk",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "There's our target, Commander. Proceed with caution—Shadow Hawks can be dangerous at any range.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "m020_180_darius"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
      },
      "name": "MissionStartDialogue",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "The Independent Prospectors' League thanks you for your assistance, Commander. We're miners, not soldiers—we can't fight these bastards off on our own.",
          "selectedCastDefId": "castDef_SE02_EmployerDefault",
          "audioName": "NONE"
        },
        {
          "words": "That's what you're paying us for. Don't worry, we'll get your platforms back.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "revealRadius": 0
        },
        {
          "words": "This isn't just about reclaiming what's ours. Majesty Metals killed hundreds of us when they tried to jump our claim. We want you to make them bleed for what they've done here.",
          "selectedCastDefId": "castDef_SE02_EmployerDefault",
          "audioName": "NONE",
          "revealRadius": 0
        },
        {
          "words": "Commander, the OpFor is holding two of the IPL's mining platforms. The first, designated Alpha, is where they're keeping their turret generator. Move in fast and take it out—those turrets hit hard, so you'll want to neutralize them ASAP.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "e15d94da-5de4-43df-9955-29d206c5076b",
          "revealRadius": 0
        },
        {
          "words": "Platform Bravo is the site of the OpFor's corporate security tower. Engage and destroy it. If they bring in a 'Mech to protect it, take that out, too. Then circle on back and we'll collect our pay.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "4a4fd778-4d76-4284-a45b-716910c63671",
          "revealRadius": 0
        },
        {
          "words": "That's right—I'm ready and waiting to authorize the transfer. Now go on, Commander… hit those corporate pigs where it hurts. We'll be watching the action from here.",
          "selectedCastDefId": "castDef_SE02_EmployerDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "6901e993-9edb-4f6e-9c99-82846438be82",
          "revealRadius": 0
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
      },
      "name": "MissionSuccessDialogue",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Stand by for extraction, Commander—let's get the hell out of here. Oh, and Darius?",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        },
        {
          "words": "I know, Meyer, I know. You want another team meeting.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "revealRadius": 0
        },
        {
          "words": "Give the man a prize.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE",
          "revealRadius": 0
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
      },
      "name": "MissionFailureDialogue",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Commander? Commander, are you reading me? Come in!",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    }
  ],
