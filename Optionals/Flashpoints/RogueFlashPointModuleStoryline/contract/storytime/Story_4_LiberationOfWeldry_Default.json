  "chunkList": [],
  "dialogueList": [
    {
      "dialogue": {
        "EncounterObjectGuid": "7fe51130-7759-4256-a3d4-fe78366c4c0e"
      },
      "name": "Async_IntruderAlert",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "[static] This is the warden—we have an intruder alert! All combat units, prepare to repel hostiles! [static]",
          "wordsColor": {
            "r": 0.2509804,
            "g": 0.2509804,
            "b": 0.2509804,
            "a": 1
          },
          "selectedCastDefId": "castDef_SE04_PrisonWardenDefault",
          "audioName": "m040_070_prisoncom",
          "revealRadius": 0
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "10b4f6db-64d8-4d3b-a2c2-ae3b73c1c132"
      },
      "name": "Inter_DestroyDoorsOrJumpWalls",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Those prison gates on either side are gonna be your best point of entry into the complex.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "7ead3d46-492e-4aeb-a331-5c6bc1dc5432",
          "cameraHeight": "High"
        },
        {
          "words": "Blow them down and make your way inside... or jump the walls, if your lance is capable of it. Your call.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "8e48d373-7f31-407a-b5ec-f3821f386e8b",
          "cameraHeight": "High"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "9071057f-44c7-44ee-a23e-10bc7bab3e00"
      },
      "name": "Inter_GoToComplete_EnemiesRemain",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Excellent work, Commander—the prison is ours.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "[static] All Directorate personnel to action stations, gods damn it! This is NOT a drill! [static]",
          "selectedCastDefId": "castDef_SE04_PrisonWardenDefault",
          "audioName": "NONE"
        },
        {
          "words": "Looks like you've got more company—I'm seeing heat signatures coming online in the prison Mech Bay. The warden must've held a lance in reserve.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "105c7821-3426-46ef-af69-175ffeab6811"
      },
      "name": "Async_PostGoToComplete",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Sit tight, Commander—Lady Arano is aware of the situation. Reinforcements are on the way.",
          "selectedCastDefId": "castDef_MadeiraDefault",
          "audioName": "m040_044_alexander"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "051ec0e7-2c7d-435b-bcbc-ce7715f774a3"
      },
      "name": "Inter_KameaArrives",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "FOR THE AURIGAN PEOPLE!",
          "selectedCastDefId": "castDef_KameaPrologue",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d61f12a3-f820-4026-b7ca-9d263d1525fa"
      },
      "name": "Inter_DropshipLanding",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Engines prepped and ready, Commander. I'll set her down as soon as you're finished with those hostiles.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "538e52fb-f8f3-4001-b3e2-1165adfa83dc"
      },
      "name": "Async_DefenderDown_Garrison",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "[static] FIGHT HARDER, DAMN YOU! We can't let this prison fall! [static]",
          "selectedCastDefId": "castDef_SE04_PrisonWardenDefault",
          "audioName": "m040_080_warden",
          "revealRadius": 0
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
      },
      "name": "MissionStartDialogue",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "There are two entrances into the complex, Commander. Intel says that each is defended by a series of elevated turrets.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "I'm also seeing an LRM emplacement between the two checkpoints.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "revealRadius": 50
        },
        {
          "words": "BattleMech defenses should be practically nil—as predicted, Lady Arano's preemptive strike has already drawn the prison's standard garrison away. I'm seeing heavy vehicles and turrets on my screen… nothing that you can't handle.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "ec9d2280-ca9a-4d90-8a20-963d8a4c0a39",
          "revealRadius": 0
        },
        {
          "words": "Clear away the opposition and capture the prison. Lady Arano and the Restoration Army will take care of the rest. Good hunting, Commander!",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "revealRadius": 0
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
      },
      "name": "MissionSuccessDialogue",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "The prison is ours! Thanks for the assist, Lady Arano—I'll have Sumire bring us down for the victory celebration.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "There will be no celebrating—not after what I saw out there. Gods, Darius… the things the Directorate has done to these people…",
          "selectedCastDefId": "castDef_KameaPrologue",
          "audioName": "NONE",
          "revealRadius": 0
        },
        {
          "words": "Kamea, I need you to meet me in the prison hospital. Right now.",
          "selectedCastDefId": "castDef_MadeiraDefault",
          "audioName": "NONE"
        },
        {
          "words": "What is it?",
          "selectedCastDefId": "castDef_KameaPrologue",
          "audioName": "NONE"
        },
        {
          "words": "Better that you see for yourself. And, Kamea… prepare yourself. This isn't going to be easy.",
          "selectedCastDefId": "castDef_MadeiraDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
      },
      "name": "MissionFailureDialogue",
      "overrideDialogueBucketId": "",
      "dialogueContent": []
    }
  ],
