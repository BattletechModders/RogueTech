  "dialogueList": [
    {
      "dialogue": {
        "EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
      },
      "name": "MissionStartDialogue",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Sorry about the rough landing. Farah, you okay in there?",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE",
          "revealRadius": 0
        },
        {
          "words": "Yeah… I'm all right. This rumble seat is even less comfortable than it looks, though.",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE"
        },
        {
          "words": "Tell me about it. Did you find the care package I left in there for you?",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE"
        },
        {
          "words": "The explosives? Yes. I'll set them to bring down the control tower after I've uploaded the Locura to the <i>Iberia</i>.",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": " 4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
      },
      "name": "MissionSuccessDialogue",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "There goes the tower… and the Directorate’s communications network along with it. Now… who wants to take bets on whether or not the plan worked?",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE"
        },
        {
          "words": "We won't have to wait long to find out. The transmission went through—the <i>Iberia</i>'s computer should be processing the Locura's code right now. I imagine that—",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE",
          "revealRadius": 0
        },
        {
          "words": "Hang on a second, Doc—we've got an incoming transmission. Putting it on screen.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
      },
      "name": "MissionFailureDialogue",
      "overrideDialogueBucketId": "",
      "dialogueContent": []
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "2edefa39-8840-42fa-81d9-6e11ece493d5"
      },
      "name": "Async_PostIntro",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Let's get moving, Commander… Lady Arano is counting on us.",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "m080_310_farah"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "fb844470-5c54-4239-86b3-89a17840a079"
      },
      "name": "Async_APCDown",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "APC down, Commander.",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "m080_320_farah",
          "revealRadius": 0
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "abcf151a-6e1e-4b71-9246-9cd4441e1322"
      },
      "name": "Async_BothAPCsDown",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "That's both APCs down! There go our chances of hacking into those turrets…",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "m080_330_farah",
          "revealRadius": 0
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "52320870-dbd3-4b01-b194-2918ccd32ae3"
      },
      "name": "Async_TurretsReached",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Powering down enemy turrets, Commander. Give us a moment, and we'll modify their targeting protocols.",
          "selectedCastDefId": "castDef_SE08_RestorationEngineerDefault",
          "audioName": "m080_350_engineer01",
          "revealRadius": 0
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "e32bf8bf-7ba2-4b6c-9874-b2c864d3ba10"
      },
      "name": "Inter_TurretControlEstablished_Alpha",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Alpha turrets are ours, Commander!",
          "selectedCastDefId": "castDef_SE08_RestorationEngineerDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "ab7aa1a1-56c0-4f42-9804-e38d48a602a3",
          "revealRadius": 0
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "e8f67080-4e68-495a-8753-770f3d188d93"
      },
      "name": "Inter_TurretControlEstablished_Bravo",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Bravo turrets belong to us!",
          "selectedCastDefId": "castDef_SE08_RestorationEngineerDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "826b9609-f13b-4983-8362-8620065551e4",
          "revealRadius": 0
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "c1e07c09-007c-4140-8fba-71bedfac24ac"
      },
      "name": "Inter_FarahReachedCommArray",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "All right, I'm inside. Should take me a few minutes to find the array's control center, hook up the drive, and prep the system to transmit the Locura to the <i>Iberia</i>.",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE",
          "revealRadius": 0
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "0fd627d4-31c4-45da-a833-77c712dedeac"
      },
      "name": "Async_FarahReachedCommArray",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "And on that note, I'm going radio silent for a bit—I need to concentrate while I work on this. I'll be in touch soon.",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "m080_360_farah"
        },
        {
          "words": "Commander, be advised that I'm seeing heavy activity on all Directorate comm channels. You're about to have company.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "m080_370_darius"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d547bdca-f0b5-4525-841e-a71d25cfbb72"
      },
      "name": "Async_FarahMechShot",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Okay, it's official—rumble seats are a bad idea, and I don't like getting shot at. I really, really don't.",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "m080_340_farah"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "b7c8461a-d1e5-498c-a817-0f3f8ff612a5"
      },
      "name": "Inter_DirectorateMechsTouchingDown",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Heads up, Commander—we've got a Directorate lance touching down!",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "m080_160_darius",
          "cameraFocusGuid": "a3397347-6f35-466a-acb9-670ea9587fc8",
          "revealRadius": 0
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "28c377a3-55bc-4169-a49b-dfa914441e77"
      },
      "name": "Async_LostAFriendlyTurret",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "We've lost a turret!",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "m080_380_farah",
          "revealRadius": 0
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "5db3cfc3-8477-4d58-9018-61d0a23d57f2"
      },
      "name": "Inter_TaurianAssaultMechsInbound",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Stay frosty! Assault 'Mechs inbound!",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "m080_180_darius",
          "cameraFocusGuid": "b7f28958-b122-4515-b7b1-ded84931303d",
          "revealRadius": 0
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "3a650127-642e-4dea-8cfc-8d5e6a2f251d"
      },
      "name": "Inter_AerospaceInbound",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Commander, Farah? I've just touched down, but we've got a problem. I have a squadron of Directorate aerospace fighters on radar, and they're headed our way.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "m080_190_sumire",
          "revealRadius": 0
        },
        {
          "words": "Damn it. We need to clear out of here before they arrive. How much time have we got?",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "m080_200_darius",
          "revealRadius": 0
        },
        {
          "words": "Not much… and they're carrying enough hardware to blow our Leopard to hell and back again.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "m080_210_sumire",
          "revealRadius": 0
        },
        {
          "words": "I can do this. Just keep the Directorate off me, Commander—I need only a few more minutes.",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "m080_220_farah",
          "revealRadius": 0
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "6a973931-555f-45d4-9b6a-4ce0eb8debdc"
      },
      "name": "Inter_TimeToBugOut",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Farah, we are OUT OF TIME. Those fighters are almost within weapons range, I need to come get you <i>NOW</i>. ",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "m080_230_sumire",
          "revealRadius": 0
        },
        {
          "words": "Remote trigger armed, explosives primed… I'm ready! Meet me at the evac point and we'll get the hell out of here!",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "m080_240_farah",
          "revealRadius": 0
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "2fc51042-1781-492a-b0e2-365ea587a45b"
      },
      "name": "Async_OstergaardAnnounce",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Attention, forces of the Arano Restoration! This is Commodore Samuel Ostergaard, formerly of the Concord Navy. As of today, I no longer serve my country; I come to you as a grieving father, not a Taurian sailor. My actions are my own.",
          "selectedCastDefId": "castDef_OstergaardDefault",
          "audioName": "m080_390_ostergaard"
        },
        {
          "words": "In three minutes' time, my ship will enter weapons range of your position. At that time, your lives will come to an abrupt end. I suggest that you pray to whatever gods— [sound of alarm klaxons] [confused shouting] [static]",
          "selectedCastDefId": "castDef_OstergaardDefault",
          "audioName": "m080_400_ostergaard"
        }
      ]
    }
  ],
