  "dialogueList": [
    {
      "dialogue": {
        "EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
      },
      "name": "MissionStartDialogue",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Good luck down there, all. I'll be cruising in the upper atmosphere and monitoring your progress, just in case. ",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "d918e4f1-2ea4-4b7f-9df8-539e363fb5f5",
          "revealRadius": 0
        },
        {
          "words": "Roger that, Ms. Meyer. Dr. Murad, have you had any luck connecting with Castle Nautilus's computer?",
          "selectedCastDefId": "castDef_KameaDefault",
          "audioName": "NONE"
        },
        {
          "words": "Already on top of it, Lady Arano. The handshake has been established and I have command-line access. Door control is being a little finicky, though.",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE",
          "revealRadius": 0
        },
        {
          "words": "Work fast, Doc. Riding in this rumble seat is like sitting on a jackhammer. In a sauna. On the sun. And Lady Arano's piloting is… aggressive.",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE",
          "revealRadius": 0
        },
        {
          "words": "Poor you. Not to worry, though—I think I've found a workaround for the problem. Get walking toward the main doors, and I'll have them open by the time you get there.",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "5cf735c3-b131-402c-801e-4b6382d9b1a3"
        },
        {
          "words": "Understood, Doctor—do whatever you have to do. Lady Arano out.",
          "selectedCastDefId": "castDef_KameaDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
      },
      "name": "MissionSuccessDialogue",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Uh, Lady Arano? What are <i>we</i> doing? ",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE"
        },
        {
          "words": "What we came here for—we're going inside. I didn't bring us all this way to leave empty-handed. Captain Grigas, are your ship and crew ready?",
          "selectedCastDefId": "castDef_KameaDefault",
          "audioName": "NONE"
        },
        {
          "words": "Aye, Lady Arano. The <i>Delfinas</i> is fully loaded and ready to drop.",
          "selectedCastDefId": "castDef_SE06_KarosasCaptainDefault",
          "audioName": "NONE"
        },
        {
          "words": "Good. Meet us at the north entrance. And hurry—we don't have much time before our unwelcome guests arrive.",
          "selectedCastDefId": "castDef_KameaDefault",
          "audioName": "NONE"
        },
        {
          "words": "Affirmative, recovery team inbound. House Karosas is proud to serve the Restoration, my lady.",
          "selectedCastDefId": "castDef_SE06_KarosasCaptainDefault",
          "audioName": "NONE"
        },
        {
          "words": "Thank you, Captain. Ready yourself, Yang—I'm taking us inside.",
          "selectedCastDefId": "castDef_KameaDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
      },
      "name": "MissionFailureDialogue",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Lady Arano, I need a status report! Do you read me? …Lady Arano, please respond!",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "b3a6a8bd-b05e-4dc3-9cc4-d333f25ab3ea"
      },
      "name": "Async_FarahWorkaround",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Okay. The standard approach isn't working—I'm inputting a valid ID, but for some reason the door won't budge. I think I've found a work-around, though. It'll just be another moment…",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "m060_410_farah"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "bfa1a007-1338-40f7-8ee3-2965c0ed72d2"
      },
      "name": "Inter_FarahTripsAlarmA",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Aaand I've got it. Okay, hang on a second. I'm going to try something.",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "86a8cf84-9ba2-45f4-af94-9c3e6f5c435d"
      },
      "name": "Inter_FarahTripsAlarmB",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Dr. Murad, what did you just do?! The lights are flickering, my <i>screen</i> is <i>dead</i>— [static]",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "Dr. Murad? Mr. Oliveira?!",
          "selectedCastDefId": "castDef_KameaDefault",
          "audioName": "NONE"
        },
        {
          "words": "The whole <i>Argo</i>'s gone dark! I'm not picking up a drive signature—whatever Farah just did, it must've knocked out her engines!",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        },
        {
          "words": "Worry about it later! Look—those vents, in the rock! They're spitting out drones!",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "f8587b94-c985-41af-9298-409b4d80ab4d",
          "cameraDistance": "Medium",
          "revealRadius": 50
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "652499fe-2478-49e5-9ead-267a8dbf9e00"
      },
      "name": "Inter_DronesDestroyed",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "We can't stay out here in the open! If we don't find harder cover, we're gonna get swamped. So what's the plan?!",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE"
        },
        {
          "words": "You fall back and find an extraction point! I'm getting you the hell out of there! \r\n",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        },
        {
          "words": "No! We have to push forward, to the doors—our only way out of this is through. Dr. Murad <i>will</i> fix this—<i>BELIEVE</i> it!",
          "selectedCastDefId": "castDef_KameaDefault",
          "audioName": "NONE"
        },
        {
          "words": "Lady Arano—",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        },
        {
          "words": "She's right, Sumire. An Outpost Castle like Nautilus could bring down a dozen Leopards—probably at the same time. If you try to extract us, it'll blow you out of the sky. ",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE"
        },
        {
          "words": "…Damn it. Okay—you're right. Stay alive down there! I'll keep trying to get Farah on the comms.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        },
        {
          "words": "Do that! For now, we've gotta get our heads back in the game—look, over there! The damned Castle is activating turrets!",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "5cf735c3-b131-402c-801e-4b6382d9b1a3"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "080e1ee6-f14b-4cf4-bc1d-e09f4217a5cc"
      },
      "name": "Inter_DronesDestroyed_AlreadyAtDoor",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "We can't stay here! If we don't find harder cover, we're gonna get swamped. So what's the plan?!",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE"
        },
        {
          "words": "You fall back and find an extraction point! I'm getting you the hell out of there!",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        },
        {
          "words": "No! We have to hold this ground until those doors open—our only way out of this is through. Dr. Murad <i>will</i> fix this—<i>BELIEVE</i> it!",
          "selectedCastDefId": "castDef_KameaDefault",
          "audioName": "NONE"
        },
        {
          "words": "Lady Arano—",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        },
        {
          "words": "She's right, Sumire. An Outpost Castle like Nautilus could bring down a dozen Leopards—probably at the same time. If you try to extract us, it'll blow you out of the sky.",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE"
        },
        {
          "words": "…Damn it. Okay—you're right. Stay alive down there! I'll keep trying to get Farah on the comms.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        },
        {
          "words": "Do that! For now, we've gotta get our heads back in the game—the damned Castle is activating turrets all around us!",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "5cf735c3-b131-402c-801e-4b6382d9b1a3"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "573f555c-eb30-4532-ba8a-97126fa4c296"
      },
      "name": "Inter_ArmoryFight",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "[static] —ady Arano? Lady Arano, do you read me?",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "revealRadius": 0
        },
        {
          "words": "Darius! Thank the gods! Tell me what's going on up there.",
          "selectedCastDefId": "castDef_KameaDefault",
          "audioName": "NONE",
          "revealRadius": 0
        },
        {
          "words": "[static] Doc Murad must've poked her nose into something she shouldn't have. Everything's going haywire up here—Doc's putting out fires as we speak. [static]",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "revealRadius": 0
        },
        {
          "words": "XO, listen to me. You tell Doc Murad that if she doesn't get these doors open right now, Lady Arano is dead. We all are!",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE"
        },
        {
          "words": "[static] I'm well aware of that, Yang! Working on it now! [static] Just… hold out a little longer. I'm working on— [static]\r\n",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4698e8ee-631d-4e2a-b351-d3193ab5c246"
      },
      "name": "Async_SumireArmoryEnd",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "We've lost contact again. Keep yourselves alive—I'll call out new contacts as I see 'em!",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "m060_430_sumire"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "57b15435-d46a-403e-b4e3-cea16f50a0c9"
      },
      "name": "Async_ArmorySpawn",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Heads up! You've got more of those little bastards coming in from the vents in the rock!",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "m060_440_sumire",
          "revealRadius": 0
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "28c4ad7c-f97b-4e9f-8dfe-3bfec6d4c8f9"
      },
      "name": "Async_ArmoryFightEnds",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "[static] Got it! Sumire, broadcast this <i>now</i>! [static]",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "m060_450_farah",
          "revealRadius": 0
        },
        {
          "words": "On it!",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "m060_460_sumire",
          "revealRadius": 0
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "cbcad37b-d957-4083-815e-9e29de24746e"
      },
      "name": "Inter_ArmoryUnlocked",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "IDENTIFIER CODE :: ACCEPTED. AUTOMATED DEFENSES DISENGAGED. WELCOME, <i>ARGO.</i>",
          "selectedCastDefId": "castDef_SE06_SLDFArmoryComputerDefault",
          "audioName": "NONE",
          "revealRadius": 0
        },
        {
          "words": "Thank the gods for that. Dr. Murad, I need a status report—what the hell is going on up there?",
          "selectedCastDefId": "castDef_KameaDefault",
          "audioName": "NONE"
        },
        {
          "words": "[static] I, ah… I used our codebreaker to access a sealed portion of the Nautilus Memory Core. When I got in, I grabbed up every encrypted file I could find, and I did get the door codes… but I also found something else. [static]",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE"
        },
        {
          "words": "What did you let loose on my ship, Doctor?",
          "selectedCastDefId": "castDef_KameaDefault",
          "audioName": "NONE"
        },
        {
          "words": "I… I don't know. Something they were researching there. It's malicious code of some kind—I think I inadvertently let it out of quarantine. [static]",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE"
        },
        {
          "words": "Yeah, and you tripped an alarm while you were at it.",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE"
        },
        {
          "words": "Look, the good news is that I've got it contained. Ninety percent certain. But it's caused a lot of damage up here. [static] Communications are patchy. Main drive system is off-line—we're floating dead in space. Lots of superficial damage, too. [static]",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE"
        },
        {
          "words": "Anyway—I'm working on it. But I could use more hands on deck. [static] Anyone who can follow basic instructions will do. The <i>Argo</i> is an enormous ship, and that code made an absolute mess of her.",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE"
        },
        {
          "words": "Understood. Sumire, I need you to fetch our people—everyone but me and Yang. Get them back to the <i>Argo</i> and do whatever Dr. Murad tells you.",
          "selectedCastDefId": "castDef_KameaDefault",
          "audioName": "NONE"
        },
        {
          "words": "Roger that, Lady Arano—I'll be there in a moment. Tell the lance to prepare for extraction.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "0551ca07-7715-4142-9540-9b2a8c50a4f7"
      },
      "name": "Async_PostFarahTripsAlarm",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Be careful of those things—they're armed to the teeth and coming in fast. And there are probably more where they came from… ",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "m060_420_yang",
          "revealRadius": 0
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "fc90cfa5-018d-414d-ab44-b80345bcc9ea"
      },
      "name": "Inter_YangReminder",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Commander, we really need to get to the entrance of the facility. Those drones aren't showing any signs of stopping, and they're going to cut us to pieces if we don't get into Nautilus.",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE"
        }
      ]
    }
  ],
