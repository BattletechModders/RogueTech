  "dialogueList": [
    {
      "dialogue": {
        "EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
      },
      "name": "Dialogue_MissionStart",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Let's get in there and find him. I hope his transistors are in one piece.",
          "selectedCastDefId": "castDef_FP_BeetleYellowA",
          "audioName": "NONE"
        },
        {
          "words": "He is really gung-ho about finding his friend. Wait...transistors?",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "8020f476-1f81-4da9-956f-a797df693984"
        },
        {
          "words": "Yeah the things that do the thinking. You know, transistors.",
          "selectedCastDefId": "castDef_FP_BeetleYellowA",
          "audioName": "NONE",
          "cameraFocusGuid": "1a670982-15d5-44cf-b76b-32433c27749e"
        },
        {
          "words": "Well I know why his friend was captured now. Do you think that what we're looking for is an Urbanmech?",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "1a670982-15d5-44cf-b76b-32433c27749e"
        },
        {
          "words": "I heard someone say 'just leave that trashcan here', so I figured they didn't want him. So I made him wake up. We were having a great time till they freaked out, shot him and dragged him away.",
          "selectedCastDefId": "castDef_FP_BeetleYellow",
          "audioName": "NONE",
          "cameraFocusGuid": "8020f476-1f81-4da9-956f-a797df693984"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
      },
      "name": "Dialogue_MissionSuccess",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Yeah, Trashy is back. Thank you Commander.",
          "selectedCastDefId": "castDef_FP_BeetleYellow",
          "audioName": "NONE"
        },
        {
          "words": "Not a problem.",
          "selectedCastDefId": "castDef_FarahDefault",
          "audioName": "NONE"
        },
        {
          "words": "One Problem. Doesn't look like they are going to let him go easy. Can I ask you to help defend us one last time?",
          "selectedCastDefId": "castDef_FP_BeetleYellowG",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
      },
      "name": "Dialogue_MissionFailure",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "No! You Monsters!!!",
          "selectedCastDefId": "castDef_FP_BeetleYellowG",
          "audioName": "NONE"
        },
        {
          "words": "I will get my revenge!",
          "selectedCastDefId": "castDef_FP_BeetleYellowG",
          "audioName": "NONE"
        },
        {
          "words": "Just you wait!",
          "selectedCastDefId": "castDef_FP_BeetleYellowG",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "6c8a5135-f5b5-4c1f-b142-d3c20f51be67"
      },
      "name": "Dialogue_ReinforcementWarning",
      "overrideDialogueBucketId": "DialogBucketDef_Universal_HostilesInbound",
      "dialogueContent": [
        {
          "words": "Commander. The enemy has deployed reinforcements and they are inbound. Expect increased resistance. ",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "127d5294-4e08-474a-962d-2b92ee7a32fb"
      },
      "name": "Dialogue_Interrupt_HunterWarning",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Damn it! We've got more enemies coming in fast!",
          "selectedCastDefId": "castDef_LocalsDefault",
          "audioName": "NONE"
        },
        {
          "words": "If they hurt Trashy again, I will be really pissed.",
          "selectedCastDefId": "castDef_LocalsDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "59fd62f4-62f0-4e14-b203-d796e231c3a8"
      },
      "name": "Dialogue_HoldOutOrders",
      "overrideDialogueBucketId": "DialogBucketDef_CaptureEscort_InPositionHoldOut",
      "dialogueContent": [
        {
          "words": "You've reached the extraction point for the objective vehicles. Hold there are keep them safe until we can get them out.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "a2f9776a-a901-4a49-8952-92d1ef9a70fd"
      },
      "name": "Dialogue_Interrupt_ConvoyMoving",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "There are four of them here, quick, let's get all back to the dropship. I'll figure out which one is Trashy there.",
          "selectedCastDefId": "castDef_FP_BeetleYellowG",
          "audioName": "NONE"
        },
        {
          "words": "It seems they were trying to copy my work. Well more friends to play with!",
          "selectedCastDefId": "castDef_FP_BeetleYellowA",
          "audioName": "NONE"
        },
        {
          "words": "Well, I would never have expected to see self driving Trashcans!",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE"
        },
        {
          "words": "It's like I have a family",
          "selectedCastDefId": "castDef_FP_BeetleYellowA",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "e8895550-a34c-4545-aa0b-27d4dfd21eeb"
      },
      "name": "Dialogue_ConvoyExtractSuccessEscapeInstruction",
      "overrideDialogueBucketId": "DialogBucketDef_CaptureEscort_ObjSecured",
      "dialogueContent": [
        {
          "words": "The drones are safely out of the AO. Good work, Commander. Now get your remaining forces to the second evac zone for extraction there. ",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    }
  ],
