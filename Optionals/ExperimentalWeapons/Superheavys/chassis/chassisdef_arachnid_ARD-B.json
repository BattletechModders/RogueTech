  "Description": {
    "Cost": 16823498,
    "UIName": "Arachnid",
    "Id": "chassisdef_arachnid_ARD-B",
    "Name": "Arachnid",
    "Details": "In an attempt to at lower the costs of the Arachnid primary configuration somewhat yet keep its alpha strike potential, the B loadout replaces the three Railguns with six standard Gauss Rifles and a total of 8 tons of Gauss ammunition. The two Extended Range PPCs were moved from the head to the center torso to benefit from the Quad Turret Mount.\n\n<b><color=#e62e00>Quirk: Intimidating</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.45</color></b>",
    "Icon": "uixTxrIcon_arachnid"
  },
