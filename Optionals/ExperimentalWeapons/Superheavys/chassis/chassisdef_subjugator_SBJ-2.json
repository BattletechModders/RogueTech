  "Description": {
    "Cost": 12304603,
    "UIName": "Subjugator",
    "Id": "chassisdef_subjugator_SBJ-2",
    "Name": "Subjugator",
    "Details": "The second variant of the Subjugator is probably the most common due to its considerably lower production and maintenance costs. To achieve this cheaper cost, the engine and gyro were downgraded and the targeting computer in the left torso was removed. To scale down the cooling costs the ER Large Pulse Lasers are replaced by Rotary AC/5s, which does mean slightly shorter optimal range for the combined weaponry, but the trade-off to lower the acquirement cost by almost 15 million c-bills is seen as well worth it.\n\n<b><color=#e62e00>Quirk: Intimidating</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.34</color></b>",
    "Icon": "uixTxrIcon_subjugator"
  },
  "VariantName": "SBJ-2",
