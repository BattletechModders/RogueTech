  "Description": {
    "Cost": 4304005,
    "UIName": "Banshee",
    "Id": "chassisdef_banshee_BNC-QS3",
    "Name": "Banshee",
    "Details": "Quicsell's Assault Missile Backstabber. The BNC-QS3 is our Streak SRM missile flagship, with 34 Streak SRM tubes and enough ammo to keep you going. Of course, as a Quicsell Backstabber line, it's about as fast as you can reasonably make a 95 ton mech move.\n\n<b><color=#e62e00>Quirk: Rugged</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.15</color></b>",
    "Icon": "uixTxrIcon_banshee"
  },
  "VariantName": "BNC-QS3",
