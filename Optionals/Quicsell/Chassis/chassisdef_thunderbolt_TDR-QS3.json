  "Description": {
    "Cost": 7366044,
    "UIName": "Thunderbolt",
    "Id": "chassisdef_thunderbolt_TDR-QS3",
    "Name": "Thunderbolt",
    "Details": "Quicsell's Heavy PPC Backstabber. The QKD-QS3 comes equped with a specially licenced XXL engine, to fit the largest possible engine into a 65 ton mech. But don't think we've cut corners with weapons, since this mech is packing two LBX PPCs that can fire while you're pounding your enemies to dust!\n\n<b><color=#e62e00>Quirk: Multi Trac</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.07</color></b>",
    "Icon": "uixTxrIcon_thunderbolt"
  },
  "VariantName": "TDR-QS3",
