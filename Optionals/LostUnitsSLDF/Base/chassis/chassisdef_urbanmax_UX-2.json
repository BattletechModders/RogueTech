  "Description": {
    "Cost": 1127487,
    "UIName": "UrbanMax",
    "Id": "chassisdef_urbanmax_UX-2",
    "Name": "UrbanMax",
    "Details": "The UrbanMax UX-2 arms an AC/5 in place of the right arm with two tons of ammunition split across the arm and torso, alongside a medium laser and small laser mounted where the left arm would be. Seven tons of heavy industrial armor protect the frame against most small arms fire.\n\n<b><color=#e62e00>Quirk: Easy to Maintain</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 0.72</color></b>\n\n<color=#FFEF00>Arm Actuator Limits: Left Upper, Right Upper</color>",
    "Icon": "uixTxrIcon_bee"
