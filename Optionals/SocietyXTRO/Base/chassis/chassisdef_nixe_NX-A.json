  "Description": {
    "Cost": 2493948,
    "UIName": "Nixe",
    "Id": "chassisdef_nixe_NX-A",
    "Name": "Nixe",
    "Details": "The A configuration of the Nixe OmniProtoMech mounts a Large Pulse Laser as its main gun to offer accurate long-range support. It is also quite useful for guarding the flanks of friendly 'Mech forces, which lets those 'Mechs focus on their own assignments instead of having to deal with enemies attacking them from behind. Like every Nixe, it is slow and mostly deployed on prepared battlefields, such as around fixed facilities.\n\n<b><color=#e62e00>Quirk: OmniProtoMech</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 0.99</color></b>",
    "Icon": "Protomech_Boggart"
  },
