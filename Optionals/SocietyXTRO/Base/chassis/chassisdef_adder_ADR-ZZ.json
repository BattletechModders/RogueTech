  "Description": {
    "Cost": 4493032,
    "UIName": "Adder",
    "Id": "chassisdef_adder_ADR-ZZ",
    "Name": "Adder",
    "Details": "The ZZ configuration of the Adder OmniMech is one of the additional loadouts the Society developed after the rebellion to bring new technology such as the Nova CEWS to designs it can readily access. To avoid the heat issues of the Prime configuration, it pairs a single ER PPC with an LRM-15 launcher, backed by extra double heat sinks. The Flamer that every Adder carries remains as a close-range backup weapon, while the Nova CEWS links it with nearby allies.\n\n<b><color=#e62e00>Quirk: Narrow/Low Profile</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.09</color></b>\n\n<color=#FFEF00>Arm Actuator Limits: Omni</color>",
    "Icon": "adder"
  },
