  "Description": {
    "Cost": 11737654,
    "UIName": "Haze",
    "Id": "chassisdef_haze_HAZ-F",
    "Name": "Haze",
    "Details": "The F configuration of the Haze OmniMech mounts an ER PPC in the right arm and a TAG in the left arm, backed by an ER Small Laser in the left torso. A Nova CEWS in the center torso connects it with other Nova-equipped units, while a Supercharger in the right torso lets it boost its speed. Extra double heat sinks spread across the torsos help it handle the heat of the ER PPC.\n\n<b><color=#e62e00>Quirk: Improved Sensors</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.05</color></b>\n\n<color=#FFEF00>Arm Actuator Limits: Omni</color>",
    "Icon": "Haze"
  },
  "VariantName": "HAZ-F",
