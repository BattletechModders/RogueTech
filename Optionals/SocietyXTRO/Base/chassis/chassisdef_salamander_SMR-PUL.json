  "Description": {
    "Cost": 3135000,
    "UIName": "Salamander",
    "Id": "chassisdef_salamander_SMR-PUL",
    "Name": "Salamander",
    "Details": "This variant of the Salamander battle armor replaces the standard pair of Flamers and the one-shot Inferno SRM with two Micro Pulse Lasers per trooper. The change was made to compensate for the average gunnery skills of inexperienced Society battle armor troopers.\n\n<b><color=#e62e00>Quirk: Fire Demon</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 0.932</color></b>\n\n<b><color=#2aad3b>Can mount any unit, can melee, can swarm.</b></color>",
    "Icon": "BA_Salamander"
  },
  "VariantName": "SMR-PUL",
