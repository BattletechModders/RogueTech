  "Description": {
    "Cost": 3157143,
    "UIName": "Lindworm",
    "Id": "chassisdef_lindworm_LND-D",
    "Name": "Lindworm",
    "Details": "The D configuration of the Lindworm OmniProtoMech is an artillery spotter equipped with jump jets that let it make long jumps. Although it is a very difficult target to hit, it is armed only with a Light TAG, so it relies on its allies to be a credible threat. Most of its users call it the ProtoMech version of the Ostscout.\n\n<b><color=#e62e00>Quirk: OmniProtoMech</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 0.986</color></b>",
    "Icon": "Protomech_Basilisk_Quad"
  },
  "VariantName": "LND-D",
