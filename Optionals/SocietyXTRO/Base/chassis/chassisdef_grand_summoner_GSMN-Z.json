  "Description": {
    "Cost": 6750612,
    "UIName": "Grand Summoner",
    "Id": "chassisdef_grand_summoner_GSMN-Z",
    "Name": "Grand Summoner",
    "Details": "The Grand Summoner is a Heavy Class Clan OmniMech which was first produced by Clan Jade Falcon during the early years of the thirty-second century. Initially produced by the Eagle Craft Group on Erewhon in the Inner Sphere, the Grand Summoner(also known by the Inner Sphere as the Thor II) proved to be a highly reliable replacement for the original Thor OmniMech. The design would soon be traded among other Inner Sphere Clans and became popular among their Warrior castes.\n\n<b><color=#e62e00>Quirk: Improved Communications</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.19</color></b>\n\n<color=#FFEF00>Arm Actuator Limits: Omni</color>",
    "Icon": "GrandSummoner"
  },
