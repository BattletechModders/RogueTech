  "Description": {
    "Cost": 5458200,
    "UIName": "Gnome",
    "Id": "chassisdef_gnome_GNM-BF",
    "Name": "Gnome",
    "Details": "With the Gnome the Society went for a full refit. The armor was updated to Basic Stealth armor, while the weaponry was replaced with an AP Gauss Rifle and a BA Fusillade. The left arm is rounded out with a cutting torch.\n\n<b><color=#e62e00>Quirk: Armored</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 0.938</color></b>\n\n<b><color=#2aad3b>Can mount Omni units, can melee, can not swarm.</b></color>",
    "Icon": "Gnome"
  },
  "VariantName": "GNM-BF",
