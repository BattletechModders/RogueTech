  "Description": {
    "Cost": 4050000,
    "UIName": "Solahma",
    "Id": "chassisdef_solahma_SLM-ASRM",
    "Name": "Solahma",
    "Details": "This variant of the Solahma Assault battle armor replaces the standard SRM-6 and AP Gauss Rifles with an Advanced SRM-6 launcher and a Micro Pulse Laser in each arm. Like every Solahma, it uses simple technology and a 'Mech-like cockpit that lets injured former MechWarriors keep fighting, and it is most commonly seen in solahma garrison formations, where it directly supports conventional infantry on foot or rides with them in APCs.\n\n<b><color=#e62e00>Quirk: Easy to Pilot</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 0.904</color></b>\n\n<b><color=#2aad3b>Can only be transported by internal bays, can melee, can not swarm.</b></color>",
    "Icon": "BA_Nephilim"
  },
  "VariantName": "SLM-ASRM",
