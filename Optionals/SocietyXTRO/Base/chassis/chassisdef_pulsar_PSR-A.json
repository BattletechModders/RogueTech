  "Description": {
    "Cost": 5291015,
    "UIName": "Pulsar",
    "Id": "chassisdef_pulsar_PSR-A",
    "Name": "Pulsar",
    "Details": "The A configuration of the Pulsar OmniMech is a fire-support loadout that mounts two ER PPCs together with enough double heat sinks to keep firing them. Its jump jets help it reach good firing positions, although at long range most MechWarriors still need a Nova CEWS-equipped spotter to be truly effective. Like every Pulsar, it carries its jump jets in pods, which leaves room for extra heat sinks, and a Nova CEWS shields it with ECM.\n\n<b><color=#e62e00>Quirk: Narrow/Low Profile</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.07</color></b>\n\n<color=#FFEF00>Arm Actuator Limits: Omni</color>",
    "Icon": "uixTxrIcon_nova"
  },
