  "Description": {
    "Cost": 2447088,
    "UIName": "Hobgoblin II",
    "Id": "chassisdef_hobgoblin_ii_HOBII-B",
    "Name": "Hobgoblin II",
    "Details": "The B configuration of the Hobgoblin II OmniProtoMech is the loadout advised for independent missions. Its arm-mounted ER Medium Lasers have the reach to be effective at longer ranges, while the AP Gauss Rifle in the torso is a useful backup weapon for engaging infantry. Jump jets let it perform combat drops and handle extreme terrain on its own, so it does not depend on other units to get around.\n\n<b><color=#e62e00>Quirk: OmniProtoMech</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 0.978</color></b>",
    "Icon": "Protomech_Gorgon"
  },
