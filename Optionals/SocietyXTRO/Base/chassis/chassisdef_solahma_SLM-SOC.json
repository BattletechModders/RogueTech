  "Description": {
    "Cost": 4230000,
    "UIName": "Solahma",
    "Id": "chassisdef_solahma_SLM-SOC",
    "Name": "Solahma",
    "Details": "This Society variant of the Solahma Assault battle armor replaces the standard SRM-6 and AP Gauss Rifles with an ER Small Laser in each arm and a BA Fusillade, a one-shot launcher that fires a salvo of iATM missiles. Its armor has been upgraded to Fire Resistant armor, allowing the suit to remain effective even in an inferno. The Society deploys it widely, as nearly all personnel can use it without drawing suspicion.\n\n<b><color=#e62e00>Quirk: Easy to Pilot</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 0.904</color></b>\n\n<b><color=#2aad3b>Can only be transported by internal bays, can melee, can not swarm.</b></color>",
    "Icon": "BA_Nephilim"
  },
  "VariantName": "SLM-SOC",
