  "Description": {
    "Cost": 2211000,
    "UIName": "Elemental II",
    "Id": "chassisdef_elemental_ii_TOAD-2BF",
    "Name": "Elemental II",
    "Details": "This variant of the Elemental II replaces the battle armor myomer booster with the maximum amount of conventional myomer bundles. The freed weight allows for fitting both a BA Fusillade one-shot missile launcher and an AP Gauss Rifle. Each suit also carries a Cutting Torch and Basic Manipulators.\n\n<b><color=#e62e00>Quirk: Standard Parts</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 0.932</color></b>\n\n<b><color=#2aad3b>Can mount Omni units, can melee, can swarm.</b></color>",
    "Icon": "BA_Elemental"
  },
  "VariantName": "TOAD-2BF",
