  "Description": {
    "Cost": 11734155,
    "UIName": "Haze",
    "Id": "chassisdef_haze_HAZ-A",
    "Name": "Haze",
    "Details": "The A configuration of the Haze OmniMech is designed to operate independently during long-term assignments. Five ER Medium Lasers, split between both arms and the left torso, give it a respectable punch and reach without depending on ammunition, while a Laser AMS helps preserve its armor by intercepting enemy missiles. An Angel ECM in the center torso further improves its defenses, making it the only Haze configuration without a Nova CEWS.\n\n<b><color=#e62e00>Quirk: Improved Sensors</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.05</color></b>\n\n<color=#FFEF00>Arm Actuator Limits: Omni</color>",
    "Icon": "Haze"
  },
