  "Description": {
    "Cost": 9002000,
    "UIName": "LRM-AV Carrier",
    "Id": "vehicledef_CARRIER_LRM_AV",
    "Name": "LRM-AV Carrier",
    "Details": "This variant replaces the old LRM Carrier's launchers with three Clan LRM-20s linked to Artemis V attachments and fixes the old missile carriers' weaknesses with thick Clan Hardened armor, a Clan XL engine, a pop-up Clan Laser AMS and a rear Clan Micro Pulse Laser against infantry. Most crews set its Clan Guardian ECM to counter enemy jamming, which keeps the Artemis V working. Because it looks so close to the LRM Carrier, crews can pass it off as a normal Inner Sphere LRM Carrier until they switch on the extra electronics.\n\n<b><color=#ffcc00>Biome Restrictions: None.</color></b>\n\n<b><color=#ffcc00>Movement: 3/5 hexes / 90/150 meters.</color></b>\n\n<color=#ffcc00><b>Armor:</b> Hardened (C)\n<b>Structure:</b> Structure\n<b>Values       A        S  </b>\n<b>Front</b>       155     30\n<b>Left</b>         125     30\n<b>Right</b>       125     30\n<b>Rear</b>        105     30\n\n<b>Total</b>      510    120</color>\n\n<color=#ff0000>Quirk: Narrow/Low Profile</color>",
    "Icon": "LRMcarrier"
  },
