  "dialogueList": [
    {
      "dialogue": {
        "EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
      },
      "name": "Dialogue_MissionStart",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "So there is good and bad news, which do you want first?",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "Bad news first, always, Darius. You should know this by now.",
          "selectedCastDefId": "castDef_Commander",
          "audioName": "NONE"
        },
        {
          "words": "As you wish, {COMMANDER.Name}. The bad news is that the enemies are not near as damaged as we were told.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "d9a28c08-abdb-42bb-a140-ad3927d1f8cf"
        },
        {
          "words": "And the good..?",
          "selectedCastDefId": "castDef_Commander",
          "audioName": "NONE"
        },
        {
          "words": "The recent batch of coffee beans I managed to acquire for the crew turned out to be really good. I just thought you'd want to know there's some good coffee to be had.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "Sometimes I do wonder what I pay you for, Darius.",
          "selectedCastDefId": "castDef_Commander",
          "audioName": "NONE"
        },
        {
          "words": "*snickers* You and me both, Commander.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
      },
      "name": "Dialogue_MissionSuccess",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Expertly handled, Commander. If you return fast enough there might even be some coffee left for you.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
      },
      "name": "Dialogue_MissionFailure",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Well, that didn't got as planned. But at least we still have the coffee.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "Darius, just shut it. And those coffee beans is coming from your paycheck.",
          "selectedCastDefId": "castDef_Commander",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "33166b96-5af2-4724-b970-7884ec41ffd0"
      },
      "name": "Dialogue_AmbushWarning",
      "overrideDialogueBucketId": "DialogBucketDef_Universal_HostilesInbound",
      "dialogueContent": [
        {
          "words": "That's it, Commander. Let's bring them time before they have time to recover.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    }
  ],
