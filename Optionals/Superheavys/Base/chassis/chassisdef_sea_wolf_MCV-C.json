  "Description": {
    "Cost": 35028968,
    "UIName": "Sea Wolf",
    "Id": "chassisdef_sea_wolf_MCV-C",
    "Name": "Sea Wolf",
    "Details": "The C loadout is focused around the huge Railgun mounted in the right side torso, allowing the delivery of an impressive amount of damage at long distances. The loadout also unusually includes two leg mounted mortars, it is unknown why the engineers decided to mount them at that location as it seems likely to impact their accuracy negatively.\n\n<b><color=#e62e00>Quirk: Multi Trac</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.4</color></b>\n\n<color=#FFEF00>Arm Actuator Limits: Omni</color>",
    "Icon": "uixTxrIcon_madcatv"
  },
