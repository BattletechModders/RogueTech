  "Description": {
    "Cost": 19662870,
    "UIName": "Shieldmaiden",
    "Id": "chassisdef_shieldmaiden_SHM-OD",
    "Name": "Shieldmaiden",
    "Details": "One of three Command versions of the Shieldmaiden, the OD has an heavily armored Command Console, C3 Master computer and Angel ECM to aid the battlefield commander. To many enemies surprise iot also brings a massive Railgun, combining impressive firepower with the command capabilities. A huge 13 ton shield in the left arm provides extra protection, and two ER Lasers and a single Light PPC work as secondary fire.\n\n<b><color=#e62e00>Quirk: Defensive Duties</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.39</color></b>\n\n<color=#FFEF00>Arm Actuator Limits: Omni</color>",
    "Icon": "uixTxrIcon_Shieldmaiden"
  },
