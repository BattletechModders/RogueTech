  "Description": {
    "Cost": 17346691,
    "UIName": "Menace",
    "Id": "chassisdef_menace_MNC-B",
    "Name": "Menace",
    "Details": "The Menace's B configuration switches to two Rotary AC/5 as the main weapons, with two Extended Range Heavy PPCs and an Improved ATM-12 launcher in each arm. A head mounted Laser AMS provides some defensive capabilities, something no other loadout brings.\n\n<b><color=#e62e00>Quirk: Stable Weapons</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.42</color></b>",
    "Icon": "uixTxrIcon_menace"
