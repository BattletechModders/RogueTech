  "Description": {
    "Cost": 11194876,
    "UIName": "Wannu",
    "Id": "chassisdef_wannu_WNU-OD",
    "Name": "Wannu",
    "Details": "The Wannu D loadout mounts a total of four Rotary AC/5  mounted with recoil dampening actuators, and a supplementary ER PPC. As the only close range weapons are three Medium Laser, the 'Mech can be vulnerable to close quarters engagements or infantry attacks, so it should be escorted by adequate friendly forces if such situations are possible.\n\n<b><color=#e62e00>Quirk: Extended Torso Twist</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.32</color></b>\n\n<color=#FFEF00>Arm Actuator Limits: Omni</color>",
    "Icon": "uixTxrIcon_wannu"
  },
