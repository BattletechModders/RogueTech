  "Description": {
    "Cost": 17719190,
    "UIName": "Menace",
    "Id": "chassisdef_menace_MNC-D",
    "Name": "Menace",
    "Details": "The D loadout of the Menace is a mix of energy and ballistic weapons. Two LBX AC/10, two Ultra AC/10, four Extended Range Heavy PPC and two Large Improved Heavy Lasers provide enough firepower to handle almost any situation the Mech can find itself in.\n\n<b><color=#e62e00>Quirk: Stable Weapons</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.42</color></b>",
    "Icon": "uixTxrIcon_menace"
