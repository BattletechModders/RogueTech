  "Description": {
    "Cost": 5804419,
    "UIName": "Victor XR",
    "Id": "chassisdef_victor_xr_VXR-015",
    "Name": "Victor XR",
    "Details": "The -015 carries a Silver Bullet Gauss Rifle in the right arm and a Light PPC with Twin Linked Capacitor in the left, making it a fearsome foe at medium to long ranges. A head mounted AMS Mk2 provides defensive capabilities.\n\n<b><color=#e62e00>Quirk: Tacticon TC7000</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.45</color></b>\n\n<color=#FFEF00>Arm Actuator Limit: Right Upper</color>",
