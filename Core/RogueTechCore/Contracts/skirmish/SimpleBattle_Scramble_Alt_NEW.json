      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "We've got them, Commander. Right out in the open.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "These guys are amateurs. Get eyes on them, take them out.",
