	"dialogueList": [
		{
			"dialogue": {
				"EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
			},
			"name": "Dialogue_MissionStart",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "Commander, the cargo terminals, designated as Alpha and Bravo, are currently handling critical supply shipments for the front.  If either terminal falls, the entire logistics chain for this sector is compromised.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE"
				},
				{
					"words": "<color=#99ebff><b>{MC.PlayerLances.TeamPilot_Position_2.DisplayName}</b></color>, reporting and in position at Bravo terminal.  We'll hold the line here.",
					"selectedCastDefId": "castDef_TeamPilot_Position_2",
					"audioName": "NONE",
					"cameraFocusGuid": "5df48a48-1840-49b0-84e9-126847053afa"
				},
				{
					"words": "Contact!  Raider lance emerging near Alpha Terminal.  {MC.PlayerLances.TeamPilot_Position_1.DisplayName}, intercept immediately.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE",
					"cameraFocusGuid": "f78cce05-8078-4f5d-b240-256af1f7f71b",
					"revealRadius": 0
				},
				{
					"words": "Copy, Darius.  I'm on station at Alpha.  We'll make them pay for every gained ground.",
					"selectedCastDefId": "castDef_TeamPilot_Position_1",
					"audioName": "NONE",
					"cameraFocusGuid": "ec9d2280-ca9a-4d90-8a20-963d8a4c0a39"
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
			},
			"name": "Dialogue_MissionSuccess",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "{MC.If.Encounter.HasNoTag.KilledAllOpfor}Outstanding work, team.\n\r\nBoth cargo terminals remain functional and loading operations are continuing despite enemy activity.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE"
				},
				{
					"words": "{MC.If.Encounter.HasNoTag.KilledAllOpfor}Mission accomplished.  Disengage and let the regulars clean up the rest.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE"
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
			},
			"name": "Dialogue_MissionFailure",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "Catastrophic damage confirmed. One of the cargo terminals has been destroyed.\n\r\nThe loading infrastructure is beyond recovery. Fuel reserves are burning and shipment operations have ceased",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE"
				},
				{
					"words": "Without both facilities operational, the shipment cannot be completed. The contract has failed.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE"
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "27482564-92b3-4ca1-b777-7fcd06c8c14d"
			},
			"name": "Dialogue_Spawn_Target_Lance_02",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "New contacts near Bravo Terminal.  {MC.PlayerLances.TeamPilot_Random_1.DisplayName}, hostile lance advancing on loading yards.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE",
					"cameraFocusGuid": "3f899376-6d15-413c-a260-a5f0aecff9bd",
					"revealRadius": 0
				},
				{
					"words": "Roger, re-calculating defensive posture.",
					"selectedCastDefId": "castDef_TeamPilot_Random_1",
					"audioName": "NONE"
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "e2e6c650-b7bd-48ad-b9e0-fc50cd0fec52"
			},
			"name": "Dialogue_Spawn_Target_Lance_03",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "Additional {TEAM_TAR.FactionDef.Demonym} raiders detected approaching Alpha from a secondary vector. {MC.PlayerLances.TeamPilot_Random_2}, you've got company.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE",
					"cameraFocusGuid": "e7acc01a-0514-468f-8b6c-7c8eeb68e1ff",
					"revealRadius": 0
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "b354e296-dcde-475d-bb49-d9b2217e5fa2"
			},
			"name": "Dialogue_Spawn_Target_Lance_04",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "Another hostile formation has entered sensor range.  Raiders are pressing the attack.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE",
					"cameraFocusGuid": "fddf5e8b-07c6-492b-861e-2d9c2bde80ee",
					"revealRadius": 0
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "78c675c1-da93-48a7-82bc-fb2b1c0d3ed3"
			},
			"name": "Dialogue_Spawn_Target_Lance_05",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "All units, Multiple signatures confirmed.  Fresh enemy lance approaching.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE",
					"cameraFocusGuid": "9cd2da77-9a07-4c41-afbe-bbfdfbe0a257",
					"revealRadius": 0
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "290a185d-ba8b-43cb-97ce-55f8b381867d"
			},
			"name": "Dialogue_Spawn_Target_Lance_06",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "More contacts emerging!\n\r\nEnemy raiders are making one last attempt to cripple the cargo terminals.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE",
					"cameraFocusGuid": "c76a6d7f-2e68-46f8-b2b1-797b5c46462c",
					"revealRadius": 0
				}
			]
		},



		{
			"dialogue": {
				"EncounterObjectGuid": "8005cebe-ec8e-44bc-ab6f-ff02000cebeb"
			},
			"name": "Dialogue_Kill_Employer_Turret_01",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "Alert!  Alpha Terminal has lost its defensive turret network.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE"
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "ef8a43ca-e05f-4126-adb4-8f2150a3cd49"
			},
			"name": "Dialogue_Kill_Employer_Turret_02",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "Bravo's automated defenses have been knocked out.  Tighten the perimeter and prevent any breakthrough.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE"
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "5bc8386c-bb9c-4d58-a0c9-50f8f0e40b2b"
			},
			"name": "Dialogue_Kill_Target_Lance_01",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "First raider lance eliminated.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE"
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "cd5ad8c9-be5e-41bc-8f2e-ec0922a3949b"
			},
			"name": "Dialogue_Kill_Target_Lance_02",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "Bravo reports successful engagement.  Hostile lance neutralized",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE"
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "8bfc2b10-b292-47e5-a2bd-a610e41aadd5"
			},
			"name": "Dialogue_Kill_Target_Lance_03",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "Good work.  Enemy reinforcements near Alpha have been destroyed.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE"
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "dab6530d-58de-48fe-87fc-3299d966dd08"
			},
			"name": "Dialogue_Kill_Target_Lance_04",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "Bravo sector holding strong.  Raider lance has been broken.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE"
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "82575c41-aa0c-41d7-9955-f69839e8a080"
			},
			"name": "Dialogue_Kill_Target_Lance_05",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "Alpha defenders score another victory.  Enemy force destroyed.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE"
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "1188645a-a257-4e78-85e2-36223c55e901"
			},
			"name": "Dialogue_Kill_Target_Lance_06",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "Last confirmed contact at Bravo has been destroyed.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE"
				}
			]
		},


		{
			"dialogue": {
				"EncounterObjectGuid": "ba5c98bc-cb87-4b52-b477-17f7af279ee1"
			},
			"name": "Dialogue_KillAllOpFor",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "{MC.Modification.AddTo.EncounterTags.KilledAllOpfor}Incredible work, team.  All hostile forces have been eliminated and both terminals remain fully operational.\n\r\nNot a single raider remains to threaten the shipment.  {TEAM_EMP.FactionDef.ShortName} logistics will be talking about this operation for years.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE"
				},
				{
					"words": "You've protected millions of C-bills worth of military supplies and preserved a critical logistics corridor.  Outstanding performance...mission complete.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE"
				}
			]
		}
	],
