	"dialogueList": [
		{
			"dialogue": {
				"EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
			},
			"name": "Dialogue_MissionStart",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "These are the coordinates that {TEAM_EMP.FactionDef.ShortName} provided, so the target officer should be in the area.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE"
				},
				{
					"words": "Engage as you see fit, Commander.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE",
					"cameraFocusGuid": "f78cce05-8078-4f5d-b240-256af1f7f71b",
					"revealRadius": 0
				},
				{
					"words": "Once he's down, head to the evac point for your pickup.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE",
					"cameraFocusGuid": "76b654a6-4f2c-4a6f-86e6-d4cf868335fe"
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
			},
			"name": "Dialogue_MissionSuccess",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "{MC.If.Encounter.HasNoTag.KilledAllOpfor}Commander, asset secured.  Mission accomplished.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE"
				},
				{
					"words": "{MC.If.Encounter.HasNoTag.KilledAllOpfor}Funny how we went from execution squad to bodyguards real quick.",
					"selectedCastDefId": "castDef_TeamPilot_Random_1",
					"audioName": "NONE"
				},
				{
					"words": "{MC.If.Encounter.HasNoTag.KilledAllOpfor}Next time, maybe they tell us who not to shoot first?",
					"selectedCastDefId": "castDef_TeamPilot_Random_2",
					"audioName": "NONE"
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
			},
			"name": "Dialogue_MissionFailure",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "We've failed...",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE"
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "bee9e015-7620-4d0b-86de-20047f5c0d84"
			},
			"name": "Dialogue_Target_Lance_01_Hint",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "{{MC.If.Encounter.HasNoTag.TeamSwapped} AND {MC.If.Encounter.HasNoTag.KilledAllOpfor}}Commander, we're getting broadcast from the target officer.",
					"selectedCastDefId": "castDef_TeamPilot_Random_1",
					"audioName": "NONE"
				},
				{
					"words": "{{MC.If.Encounter.HasNoTag.TeamSwapped} AND {MC.If.Encounter.HasNoTag.KilledAllOpfor}}<color=#99ebff>Target Officer:</color> This is <i><static noise></i> of {TEAM_TAR.FactionDef.Name}.  I am requesting asylum.  Repeat --- requesting asylum with {TEAM_EMP.FactionDef.Name} forces.",
					"selectedCastDefId": "castDef_TeamLeader_Target",
					"audioName": "NONE"
				},
				{
					"words": "{{MC.If.Encounter.HasNoTag.TeamSwapped} AND {MC.If.Encounter.HasNoTag.KilledAllOpfor}}All units, stand by.  Do not engage the primary target yet.\n\r\nWe are receiving corroborating signals...encrypted but consistent with defection protocols.",
					"selectedCastDefId": "castDef_TeamLeader_Employer",
					"audioName": "NONE"
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "3d1097b0-5e92-4dd3-8764-901881dc2480"
			},
			"name": "Dialogue_Target_Lance_01_Swap",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "{{MC.If.Encounter.HasNoTag.TeamSwapped} AND {MC.If.Encounter.HasNoTag.KilledAllOpfor}}Commander, this could be a trap.  {TEAM_TAR.FactionDef.Demonym} are known for deception operations.  Continue to engage escorts only.  Maintain distance from the target.",
					"selectedCastDefId": "castDef_TeamPilot_Random_1",
					"audioName": "NONE"
				},
				{
					"words": "{MC.If.Encounter.HasNoTag.KilledAllOpfor}...<i><static noise></i> is compromised!  All {TEAM_TAR.FactionDef.Demonym} units --- execute loyalty purge!",
					"selectedCastDefId": "castDef_TeamLeader_Target",
					"audioName": "NONE",
					"cameraFocusGuid": "ce56f076-15a6-490b-a73f-71316b1566c4",
					"cameraDistance": "Medium"
				},
				{
					"words": "{{MC.If.Encounter.HasNoTag.TeamSwapped} AND {MC.If.Encounter.HasNoTag.KilledAllOpfor}}Yeah...that doesn't sound like a fake.",
					"selectedCastDefId": "castDef_TeamPilot_Random_1",
					"audioName": "NONE"
				},
				{
					"words": "{MC.Modification.AddTo.EncounterTags.TeamSwapped}{MC.If.Encounter.HasNoTag.KilledAllOpfor}Commander, command confirmation received.  The {TEAM_TAR.FactionDef.Demonym} officer carries strategic data caches: military positions, supply lines...this is real.",
					"selectedCastDefId": "castDef_TeamLeader_Employer",
					"audioName": "NONE",
					"cameraFocusGuid": "f78cce05-8078-4f5d-b240-256af1f7f71b",
					"cameraDistance": "Medium"
				},
				{
					"words": "{MC.Modification.AddTo.EncounterTags.TeamSwapped}{MC.If.Encounter.HasNoTag.KilledAllOpfor}Orders updated.  The {TEAM_TAR.FactionDef.Demonym} officer is now a Priority Alpha asset.\n\r\nProtect and escort to the evac zone.",
					"selectedCastDefId": "castDef_TeamLeader_Employer",
					"audioName": "NONE",
					"cameraFocusGuid": "f78cce05-8078-4f5d-b240-256af1f7f71b",
					"cameraDistance": "Medium"
				},
				{
					"words": "{MC.Modification.AddTo.EncounterTags.TeamSwapped}{MC.If.Encounter.HasNoTag.KilledAllOpfor}You want us to babysit him now?",
					"selectedCastDefId": "castDef_TeamPilot_Random_1",
					"audioName": "NONE",
					"cameraFocusGuid": "f78cce05-8078-4f5d-b240-256af1f7f71b",
					"cameraDistance": "Medium"
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "b354e296-dcde-475d-bb49-d9b2217e5fa2"
			},
			"name": "Dialogue_Target_Lance_04_Spawn",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "Dialogue_Target_Lance_04_Spawn",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE",
					"cameraDistance": "Medium"
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "78c675c1-da93-48a7-82bc-fb2b1c0d3ed3"
			},
			"name": "Dialogue_Target_Lance_05_Spawn",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "Dialogue_Target_Lance_05_Spawn",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE",
					"cameraDistance": "Medium"
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "d4b42374-41f6-4318-8c79-2cd096fc1c95"
			},
			"name": "Dialogue_Target_Lance_01_Evacs",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "{MC.If.Encounter.HasNoTag.KilledAllOpfor}We have the asset!  Move your team up and exfiltrate, as well.",
					"selectedCastDefId": "castDef_TeamLeader_Employer",
					"audioName": "NONE",
					"cameraFocusGuid": "ce56f076-15a6-490b-a73f-71316b1566c4"
				},
				{
					"words": "{MC.If.Encounter.HasNoTag.KilledAllOpfor}So...we just saved the guy we were supposed to kill.",
					"selectedCastDefId": "castDef_TeamPilot_Random_1",
					"audioName": "NONE",
					"cameraFocusGuid": "ce56f076-15a6-490b-a73f-71316b1566c4"
				},
				{
					"words": "{MC.If.Encounter.HasNoTag.KilledAllOpfor}What matters is that we get paid.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE",
					"cameraFocusGuid": "ce56f076-15a6-490b-a73f-71316b1566c4"
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "e8a5d081-6749-4167-98dc-05471014ed78"
			},
			"name": "Dialogue_KillAllOpfor",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "{MC.Modification.AddTo.EncounterTags.KilledAllOpfor}Confirming...all hostile {TEAM_TAR.FactionDef.ShortName} signatures have been eliminated.",
					"selectedCastDefId": "castDef_TeamLeader_Employer",
					"audioName": "NONE",
					"cameraDistance": "Medium"
				},
				{
					"words": "...That's it? No reinforcements?",
					"selectedCastDefId": "castDef_TeamPilot_Random_1",
					"audioName": "NONE",
					"cameraDistance": "Medium"
				},
				{
					"words": "Negative.  The AO is secure.",
					"selectedCastDefId": "castDef_TeamLeader_Employer",
					"audioName": "NONE",
					"cameraDistance": "Medium"
				},
				{
					"words": "{MC.If.Encounter.HasNoTag.TeamSwapped}This outcome is...acceptable.",
					"selectedCastDefId": "castDef_TeamLeader_Employer",
					"audioName": "NONE",
					"cameraDistance": "Medium"
				},
				{
					"words": "{MC.If.Encounter.HasNoTag.TeamSwapped}\"Acceptable\"?  We just wiped a full {TEAM_TAR.FactionDef.Demonym} response force...aand bagged you a high-rangking defector.",
					"selectedCastDefId": "castDef_TeamPilot_Random_1",
					"audioName": "NONE",
					"cameraDistance": "Medium"
				}
			]
		}
	],
