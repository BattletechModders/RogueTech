	"dialogueList": [
		{
			"dialogue": {
				"EncounterObjectGuid": "939990b1-64f2-4f43-abb5-5c9dbcafee78"
			},
			"name": "Dialogue_PreMission",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "\t<color=#99ebff><i><b>A FEW MINUTES AGO...</b></i></color>\n\r\n\r\nLooks like {TEAM_EMP.FactionDef.ShortName}'s intel was right.  We're picking up {TEAM_TAR.FactionDef.Demonym} comm chatter from this area.  Guessing they're the ones backing these raiders.\n\r\nThis could get ugly. Commander, priority one is to keep them away from the base.  We've set your drop point coordinates, Oliveira out.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE",
					"cameraDistance": "Medium"
				},
				{
					"words": "\t<color=#99ebff><i><b>...A MINUTE AGO...</b></i></color>\n\r\n\r\n<i>Alarm warning sounds</i>\n\r\nWarning: Environmental instability detected.  Descent vectors deviating.",
					"selectedCastDefId": "castDef_Computer",
					"audioName": "NONE",
					"cameraDistance": "Medium"
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
			},
			"name": "Dialogue_MissionStart",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "\t<color=#99ebff><i><b>...PRESENT...</b></i></color>\n\r\n\r\n<color=#99ebff><b>{MC.PlayerLances.TeamPilot_Position_1.DisplayName}</b></color> down at LZ Alpha, systems green.  Sound off!",
					"selectedCastDefId": "castDef_TeamPilot_Position_1",
					"audioName": "NONE",
					"cameraFocusGuid": "21a03616-c88b-4edd-a9a9-b4dd54b46d6c",
					"cameraDistance": "Medium"
				},
				{
					"words": "<color=#99ebff><b>{MC.PlayerLances.TeamPilot_Position_4.DisplayName}</b></color> down --- close enough to you.  Took minor armor scuffs, still combat capable.",
					"selectedCastDefId": "castDef_TeamPilot_Position_4",
					"audioName": "NONE",
					"cameraFocusGuid": "0f10a383-7325-4726-b2c4-a0ef416e4b27"
				},
				{
					"words": "<color=#99ebff><b>{MC.PlayerLances.TeamPilot_Position_3.DisplayName}</b></color> here, I'm between you and...wherever <color=#99ebff><b>{MC.PlayerLances.TeamPilot_Position_2.DisplayName}</b></color> ended up.",
					"selectedCastDefId": "castDef_TeamPilot_Position_3",
					"audioName": "NONE",
					"cameraFocusGuid": "a55fc76c-c955-4b61-bb64-2608c9beb9f5"
				},
				{
					"words": "-zzzt-  <color=#99ebff><b>{MC.PlayerLances.TeamPilot_Position_2.DisplayName}</b></color> reporting!  I'm way off target...",
					"selectedCastDefId": "castDef_TeamPilot_Position_2",
					"audioName": "NONE",
					"cameraFocusGuid": "5df48a48-1840-49b0-84e9-126847053afa"
				},
				{
					"words": "This is not ideal.  Raiders are advancing sooner than expected.  You must hold the base perimeter despite your scattered positions.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE",
					"cameraFocusGuid": "21a03616-c88b-4edd-a9a9-b4dd54b46d6c",
					"cameraDistance": "Medium"
				},
				{
					"words": "You heard Darius.  No regroup --- we hold where we stand.  <color=#99ebff><b>{MC.PlayerLances.TeamPilot_Position_4.DisplayName}</b></color>, stick close.  <color=#99ebff><b>{MC.PlayerLances.TeamPilot_Position_3.DisplayName}</b></color>, screen the gap.  <color=#99ebff><b>{MC.PlayerLances.TeamPilot_Position_2.DisplayName}</b></color>...survive and move in when you can.",
					"selectedCastDefId": "castDef_TeamPilot_Position_1",
					"audioName": "NONE",
					"cameraFocusGuid": "21a03616-c88b-4edd-a9a9-b4dd54b46d6c",
					"cameraDistance": "Medium"
				},
				{
					"words": "Yeah, no pressure, right?",
					"selectedCastDefId": "castDef_TeamPilot_Position_2",
					"audioName": "NONE",
					"cameraFocusGuid": "5df48a48-1840-49b0-84e9-126847053afa",
					"cameraDistance": "Medium"
				},
				{
					"words": "Welcome to mercenary work.  All units, defensive posture.  Protect the base.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE",
					"cameraFocusGuid": "21a03616-c88b-4edd-a9a9-b4dd54b46d6c",
					"cameraDistance": "Medium"
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
			},
			"name": "Dialogue_MissionSuccess",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "{COMPANY.CompanyName}, this is {TGT_SYSTEM.Name} Base Command.  The base remains secure.\n\r\nYour payment is being processed.  Additionally...we will be reviewing the origin of these attackers.  This was no simple raid.",
					"selectedCastDefId": "castDef_TeamLeader_Employer",
					"audioName": "NONE"
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
			},
			"name": "Dialogue_MissionFailure",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "Raiders, we could handle.  Unexpected {TEAM_TAR.FactionDef.Demonym} military units?  Let's pack it in, Commander.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE"
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "b474bf32-0ce8-4f6e-9abd-2bfb317e3b23"
			},
			"name": "Dialogue_Spawn_Target_Lance_01b",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "Additional hostile signatures just entered the AO; enemy reinforcements inbound.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE",
					"cameraFocusGuid": "3f899376-6d15-413c-a260-a5f0aecff9bd",
					"revealRadius": 0
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "e2e6c650-b7bd-48ad-b9e0-fc50cd0fec52"
			},
			"name": "Dialogue_Spawn_Target_Lance_02",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "All units, be advised, new contacts inbound.  Multiple signatures dropping into your AO.  This is a second wave.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE",
					"cameraFocusGuid": "e7acc01a-0514-468f-8b6c-7c8eeb68e1ff",
					"revealRadius": 0
				},
				{
					"words": "You've got to be kidding me.  I just got within range!",
					"selectedCastDefId": "castDef_TeamPilot_Random_1",
					"audioName": "NONE"
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "b354e296-dcde-475d-bb49-d9b2217e5fa2"
			},
			"name": "Dialogue_Spawn_Target_Lance_02b",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "These raiders are more coordinated than expected.  They're not just charging, they're probing our defenses.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE",
					"cameraFocusGuid": "fddf5e8b-07c6-492b-861e-2d9c2bde80ee",
					"revealRadius": 0
				},
				{
					"words": "No complaints.  More targets means we're doing something right.",
					"selectedCastDefId": "castDef_TeamPilot_Random_2",
					"audioName": "NONE",
					"cameraFocusGuid": "fddf5e8b-07c6-492b-861e-2d9c2bde80ee",
					"revealRadius": 0
				},
				{
					"words": "Reiterating primary objective: defend the base structures.  If those fall, this contract fails.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE",
					"cameraFocusGuid": "fddf5e8b-07c6-492b-861e-2d9c2bde80ee",
					"revealRadius": 0
				},
				{
					"words": "Copy.  All units, tighten the line.  We hold here, no matter what drops out of the sky.",
					"selectedCastDefId": "castDef_TeamPilot_Random_2",
					"audioName": "NONE",
					"cameraFocusGuid": "fddf5e8b-07c6-492b-861e-2d9c2bde80ee",
					"revealRadius": 0
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "ecee75b6-5928-46ca-9b22-de521545a3b1"
			},
			"name": "Dialogue_Destroy_Target_Lance_01",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "That's the last of the first lance, targets eliminated.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE",
					"revealRadius": 0
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "887a6df6-7ab2-4db5-a890-0bd8c5b10162"
			},
			"name": "Dialogue_Destroy_Target_Lance_01b",
			"overrideDialogueBucketId": "DialogBucketDef_Universal_KillConfirmed",
			"dialogueContent": [
				{
					"words": "Good shooting, but don't celebrate yet.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE",
					"revealRadius": 0
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "02e4bb15-0b93-4d0a-822d-2f329cd17ff7"
			},
			"name": "Dialogue_Destroy_Target_Lance_02",
			"overrideDialogueBucketId": "DialogBucketDef_Universal_KillConfirmed",
			"dialogueContent": [
				{
					"words": "Splash another one!",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE",
					"revealRadius": 0
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "17bf0f8e-6981-418f-977a-8be74da49542"
			},
			"name": "Dialogue_Destroy_Target_Lance_02b",
			"overrideDialogueBucketId": "DialogBucketDef_Universal_KillConfirmed",
			"dialogueContent": [
				{
					"words": "Whoo hoo!",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE",
					"revealRadius": 0
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "4350fb06-958d-4d1e-8e46-9e886a2466f1"
			},
			"name": "Dialogue_AllTurretsDestroyed",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "Commander, all base defenses are destroyed.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE",
					"revealRadius": 0
				}
			]
		},
		{
			"dialogue": {
				"EncounterObjectGuid": "e8a5d081-6749-4167-98dc-05471014ed78"
			},
			"name": "Dialogue_DestroyAllOpfor",
			"overrideDialogueBucketId": "",
			"dialogueContent": [
				{
					"words": "{MC.Modification.AddTo.EncounterTags.KilledAllOpfor}Confirmed.  AO is clear.  No incoming drops, no reinforcements on scope.",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE"
				},
				{
					"words": "Not bad for a \"scattered deployment,\" huh?",
					"selectedCastDefId": "castDef_DariusDefault",
					"audioName": "NONE"
				}
			]
		}
	],
