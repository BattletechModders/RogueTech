  "dialogueList": [
    {
      "dialogue": {
        "EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
      },
      "name": "Dialogue_MissionStart",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "There are two main settlements in this area. You know how this goes. Let's do a sweep and get more info, Commander. And let's hope this is just a case of some bad comms systems... the alternative won't be pretty.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
      },
      "name": "Dialogue_MissionSuccess",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Thank you, Commander. I'll personally make sure this witness makes a difference at the trial.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "Nice to make a difference. Especially when we get paid.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
      },
      "name": "Dialogue_MissionFailure",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "This isn't looking good. We're coming to get you out fast. We can't do anything else to help this poor soul.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "e0ca3227-ffbf-4088-a261-3d4e9ab7d4c5"
      },
      "name": "Dialogue_First_Point_Of_Interest",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "There's nothing here. This settlement looks long abandoned. Let's quickly move on to the next one.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "e7e9f35b-7ed8-404e-9dae-69be61de2dd3",
          "cameraDistance": "Medium"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "f404adfd-7613-4fc3-ae55-f025ac6d8213"
      },
      "name": "Dialogue_First_Point_Of_Interest_Trap",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Gotcha! I'm not going down without a fight, you bastards. I saw what you did and I'll let the whole world know at the trial!",
          "selectedCastDefId": "castDef_MC_WitnessInProtection",
          "audioName": "NONE",
          "cameraFocusGuid": "e7e9f35b-7ed8-404e-9dae-69be61de2dd3",
          "cameraDistance": "Medium"
        },
        {
          "words": "I recognise that voice... that's the witness! This seems to be a recorded message though...",
          "selectedCastDefId": "castDef_TeamLeader_Employer",
          "audioName": "NONE",
          "cameraFocusGuid": "e7e9f35b-7ed8-404e-9dae-69be61de2dd3",
          "cameraDistance": "Medium"
        },
        {
          "words": "That's real great - they think we're after them. Turrets spinning up! Better deal with this first then we can go 'thank' the witness.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "e7e9f35b-7ed8-404e-9dae-69be61de2dd3",
          "cameraDistance": "Medium"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "47c75ee8-8af6-46a8-98a3-418f754616c5"
      },
      "name": "Dialogue_First_Point_Of_Interest_Ambush",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Right where we were told you'd... wait... you're not who we're looking for! We'll just have to go through you lot first then.",
          "selectedCastDefId": "castDef_MC_LanceLeader1",
          "audioName": "NONE",
          "cameraFocusGuid": "e7e9f35b-7ed8-404e-9dae-69be61de2dd3"
        },
        {
          "words": "Multiple contacts. Incoming hostiles. Engage at will, Commander.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "e7e9f35b-7ed8-404e-9dae-69be61de2dd3"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "399d54e8-522a-4576-b01f-14d705dc9d6b"
      },
      "name": "Dialogue_Post_1b",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "What a pain that was. We couldn't even trace the location of the witness as it was just a recording. We've got no choice but to head to the next settlement and hope they're there.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "e7e9f35b-7ed8-404e-9dae-69be61de2dd3",
          "cameraDistance": "Medium",
          "cameraHeight": "High"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "e090fbc3-13e3-4829-9093-1000b4e50dbd"
      },
      "name": "Dialogue_Post_1c",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "No doubt that party was thrown for our witness. We better hurry to the other settlement. They might need more help.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "e7e9f35b-7ed8-404e-9dae-69be61de2dd3",
          "cameraDistance": "Medium",
          "cameraHeight": "High"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4ef16b5e-1486-4399-8835-b81026b22cac"
      },
      "name": "Dialogue_Second_Point_Of_Interest_3a",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "You're too late. We've secured this site and once we find that damn snitch we're taking them with us to suffer and there's not a goddamn thing you can do to stop us.",
          "selectedCastDefId": "castDef_MC_LanceLeader2",
          "audioName": "NONE",
          "cameraFocusGuid": "21a03616-c88b-4edd-a9a9-b4dd54b46d6c",
          "cameraDistance": "Close"
        },
        {
          "words": "Sounds like they haven't found our witness yet. Good.",
          "selectedCastDefId": "castDef_TeamLeader_Employer",
          "audioName": "NONE",
          "cameraFocusGuid": "21a03616-c88b-4edd-a9a9-b4dd54b46d6c",
          "cameraDistance": "Close"
        },
        {
          "words": "{TEAM_TAR.FactionDef.Demonym} force, you're outgunned and outmatched. Release your captive and surrender or we'll be forced to fire on your position.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "21a03616-c88b-4edd-a9a9-b4dd54b46d6c",
          "cameraDistance": "Close"
        },
        {
          "words": "...Ha! That's what you think. Time to go, boys!",
          "selectedCastDefId": "castDef_MC_LanceLeader2",
          "audioName": "NONE",
          "cameraFocusGuid": "21a03616-c88b-4edd-a9a9-b4dd54b46d6c",
          "cameraDistance": "Medium"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "5b3c49fe-d2a6-46ba-b0b7-21a43fd254a9"
      },
      "name": "Dialogue_3a_Enemy_Turrets_Activating",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "They've activated the base turrets, Commander. Add that to the pile of things to handle.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "98fc619a-28f5-4a29-ae7f-5f42576cd0bc",
          "cameraDistance": "Medium"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "ebfc6319-b365-478d-af8c-cfa8a38ad1e4"
      },
      "name": "Dialogue_3a_Employer_Turrets_Activating",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Hey Commander! I'm the one they're looking for. These bastards murdered a whole town including my family. Let's hurt them. I've just finished setting up a trap so let me help you help me.",
          "selectedCastDefId": "castDef_MC_WitnessInProtection",
          "audioName": "NONE",
          "cameraFocusGuid": "98fc619a-28f5-4a29-ae7f-5f42576cd0bc",
          "cameraDistance": "Medium"
        },
        {
          "words": "Commander! Turrets are coming online... they aren't pointed at us though. Looks like we've got some backup.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "98fc619a-28f5-4a29-ae7f-5f42576cd0bc",
          "cameraDistance": "Medium"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d530f8a5-ce14-4af8-8da3-2020dab6def1"
      },
      "name": "Dialogue_Second_Point_Of_Interest_3b",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "{TGT_SYSTEM.name} settlement. We're a {TEAM_EMP.FactionDef.Demonym} aligned force attempting to offer aid and support. What's the current situation here?",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "21a03616-c88b-4edd-a9a9-b4dd54b46d6c",
          "cameraDistance": "Close"
        },
        {
          "words": "Am I glad to see you guys. I'm in witness protection but these murdering bastards found me. I watched them burn my wife and son and do the same for my whole damn town. Now they want to do the same here. Please... stop them!",
          "selectedCastDefId": "castDef_MC_WitnessInProtection",
          "audioName": "NONE",
          "cameraFocusGuid": "21a03616-c88b-4edd-a9a9-b4dd54b46d6c",
          "cameraDistance": "Medium"
        },
        {
          "words": "Hold tight. We'll do what we can.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "21a03616-c88b-4edd-a9a9-b4dd54b46d6c",
          "cameraDistance": "Close"
        },
        {
          "words": "Commander, you've got an incoming Leopard on your position. They'll be on you in moments.",
          "selectedCastDefId": "castDef_SumireDefault",
          "audioName": "NONE",
          "cameraFocusGuid": "21a03616-c88b-4edd-a9a9-b4dd54b46d6c",
          "cameraHeight": "High"
        }
      ]
    }
  ],
