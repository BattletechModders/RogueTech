  "dialogueList": [
    {
      "dialogue": {
        "EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
      },
      "name": "Dialogue_MissionStart",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "The seasonal Assault 'Mech tournament is beginning to enter its twilight hours, folks! Figuratively, of course. It's still bright and sunny down on the faux streets of the arena, and it's just as well! We've got another exciting new match coming your way!",
          "selectedCastDefId": "castDef_HaretonDefault",
          "audioName": "NONE"
        },
        {
          "words": "You might be thinking \"gee, isn't he all Splimbyed out?\"\n\nThe answer is no. I am <i>never</i> done Splimbying. Do not <i>ever</i> doubt me again.",
          "selectedCastDefId": "castDef_HaretonDefault",
          "audioName": "NONE"
        },
        {
          "words": "What?",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "On with the match!",
          "selectedCastDefId": "castDef_HaretonDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
      },
      "name": "Dialogue_MissionSuccess",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Another hair-raising finish from {COMPANY.CompanyName}! Is there no stopping these titular, titanic titans?!",
          "selectedCastDefId": "castDef_HaretonDefault",
          "audioName": "NONE"
        },
        {
          "words": "Clean kill, Commander. I'll meet you back on the bridge.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
      },
      "name": "Dialogue_MissionFailure",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Ohh! I felt that from here!! {COMPANY.CompanyName} tried so hard, and got so far! But in the end, it didn't make a difference! They are OUT!",
          "selectedCastDefId": "castDef_HaretonDefault",
          "audioName": "NONE"
        },
        {
          "words": "I don't think that's how that saying goes.\n\nWhatever. We'll need to revise our approach for next time, Commander.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    }
  ],
