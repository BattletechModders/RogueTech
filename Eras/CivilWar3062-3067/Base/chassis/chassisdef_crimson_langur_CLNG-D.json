  "Description": {
    "Cost": 5357602,
    "UIName": "Crimson Langur",
    "Id": "chassisdef_crimson_langur_CLNG-D",
    "Name": "Crimson Langur",
    "Details": "This configuration has the same base movement profile as the Crimson Langur Prime configuration, but the weaponry has been replaced. Instead of the Prime's loadout, two ER micro lasers, a medium pulse laser, and a Streak SRM-4 are mounted in each arm. The lasers are tied into a targeting computer, and a light TAG allows this configuration to call for artillery support.\n\n<b><color=#e62e00>Quirk: Improved Communications</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.05</color></b>\n\n<color=#FFEF00>Arm Actuator Limits: Omni</color>",
    "Icon": "uixTxrIcon_crimsonlangur"
  },
