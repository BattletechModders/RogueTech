  "dialogueList": [
    {
      "dialogue": {
        "EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
      },
      "name": "Dialog_MissionStart",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Commander, you arrived just in time. Those pirates are almost upon us.",
          "selectedCastDefId": "castDef_FP_SharonBryan",
          "audioName": "NONE"
        },
        {
          "words": "Interstellar Expeditions has provided us with the technicians we need to get this base back up and running.",
          "selectedCastDefId": "castDef_FP_SharonBryan",
          "audioName": "NONE"
        },
        {
          "words": "Lets hold this line so we can get these artifacts off world.",
          "selectedCastDefId": "castDef_FP_SharonBryan",
          "audioName": "NONE",
          "cameraFocusGuid": "4d39e72c-4f99-4cc6-8fe0-d4d18cad0063"
        },
        {
          "words": "There are some very unique things buried under this complex.",
          "selectedCastDefId": "castDef_FP_SharonBryan",
          "audioName": "NONE",
          "cameraFocusGuid": "dafd0d98-c88a-4f90-b137-4fe5ed94ebbb"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
      },
      "name": "Dialog_MissionSuccess",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Great work commander. Lets meet up and discuss payment.",
          "selectedCastDefId": "castDef_FP_SharonBryan",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
      },
      "name": "Dialog_MissionFailure",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "No, oh No, everything is lost. Interstellar Expeditions will not be happy with this",
          "selectedCastDefId": "castDef_FP_SharonBryan",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "37095331-664a-4ccd-b09a-8693f0ea6653"
      },
      "name": "Dialogue_Interrupt_CapturedTurrets",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Turrets online, IE will be happy with the results.",
          "selectedCastDefId": "castDef_FP_SharonBryan",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d7184f62-0021-41af-a5a4-34a585aa9d39"
      },
      "name": "Dialogue_ReinforcementWarning",
      "overrideDialogueBucketId": "DialogBucketDef_Universal_HostilesInbound",
      "dialogueContent": [
        {
          "words": "Warning commander, sensors are reading multiple contacts approaching from multiple vectors. Looks like the attacking force has brought reinforcements. ",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d382339d-0cc4-483f-b64d-4a93f3009f7e"
      },
      "name": "Dialogue_BuildingDamaged",
      "overrideDialogueBucketId": "DialogBucketDef_DefendBase_AllyStruct-Damaged",
      "dialogueContent": [
        {
          "words": "No, No, No. These things are old and fragile, they can't be shaken like this. ",
          "selectedCastDefId": "castDef_FP_SharonBryan",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "56262d64-510a-45a1-9a7a-cdadd02a27ec"
      },
      "name": "Dialogue_BuildingDestroyed",
      "overrideDialogueBucketId": "DialogBucketDef_DefendBase_AllyStruct-Destroyed",
      "dialogueContent": [
        {
          "words": "Hundreds of years of research lost in just a mere moment.",
          "selectedCastDefId": "castDef_FP_SharonBryan",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "6830c98e-266c-4185-9358-41aef95b471d"
      },
      "name": "Dialogue_Interrupt_OneBuildingLeft",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "We have almost lost all of this find Commander.",
          "selectedCastDefId": "castDef_FP_SharonBryan",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "04aca727-601c-4fea-9f14-9cbef76768b3"
      },
      "name": "Dialogue_HalfwayAlert",
      "overrideDialogueBucketId": "DialogBucketDef_DefendBase_AllyReinforcements",
      "dialogueContent": [
        {
          "words": "We are halfway loaded Commander. Keep up the good work",
          "selectedCastDefId": "castDef_FP_SharonBryan",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "f2f3007e-6680-4656-a3cf-1f5376c2377a"
      },
      "name": "Dialogue_Interrupt_TurretBriefing",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Commander, on this outing we have some additional support from our employer.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "They have point defenses set up around the base. However, they are off-line.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "We have a friendly convoy with engineers who are eager to get at those defenses, so they can bring them online.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        },
        {
          "words": "Escort them safely to the generators and we can boost our defensive capability with those turrets activated. Good luck!",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    }
  ],
