  "Description": {
    "Cost": 680466,
    "UIName": "Jed",
    "Id": "vehicledef_JEdgar_PRIMITIVE",
    "Name": "Jed",
    "Details": "This retro-tech equipment package is popular with low rent mercs and cash strapped militias. It actually exceeds the punch of the original, until the rockets run out. Designed as a fast, cheap, and effective raider, the J.Edgar was the last military vehicle that Alphard Trading Corporation manufactured before they disappeared during the conflagration of the Succession Wars. Unfortunately, the J.Edgar proved quite ineffective and was soon phased out, until Pinard Protectorates Limited licensed the design and began manufacturing new variants. \n\n<b><color=#ffcc00>Biome Restrictions: This unit can not deploy in Lunar or Martian biomes due to using an ICE.</color></b>\n\n<b><color=#ffcc00>Movement: 8/12 hexes / 240/360 meters.</color></b>\n\n<color=#ffcc00><b>Armor:</b> Armor\n<b>Structure:</b> Structure\n<b>Values       A        S  </b>\n<b>Front</b>       130     15\n<b>Left</b>          95     15\n<b>Right</b>        95     15\n<b>Rear</b>         75     15\n<b>Turret</b>      120     15\n\n<b>Total</b>      515     75</color>\n\n<color=#ff0000>Quirk: Accurate Weapon - Laser</color>",
    "Icon": "J.edgar"
  },
