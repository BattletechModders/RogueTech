  "Description": {
    "Cost": 1890567,
    "UIName": "Slowpoke",
    "Id": "chassisdef_slowpoke_SLP-2U",
    "Name": "Slowpoke",
    "Details": "The Slowpoke is armed with a single medium laser in the center torso. With a movement profile matching the infamous UrbanMech, its two and a half tons of armor is woefully inadequate even though it provides near maximum protection for a 'Mech of this small size. The jump jets can vault the Slowpoke 65 meters.\n\n<b><color=#e62e00>Quirk: Rugged</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 0.99</color></b>",
    "Icon": "uixTxrIcon_mite"
  },
  "VariantName": "SLP-2U",
  "ChassisTags": {
    "items": [
      "Squad",
