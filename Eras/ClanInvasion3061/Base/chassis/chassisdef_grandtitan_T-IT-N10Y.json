  "Description": {
    "Cost": 1701493,
    "UIName": "Grand Titan",
    "Id": "chassisdef_grandtitan_T-IT-N10Y",
    "Name": "Grand Titan",
    "Details": "The Grand Titan T-IT-N10Y was Vining's attempt to combine the best of the -N10X prototype with more modern technology. It carries an experimental XXL engine and restores the one-shot weapons that the -N10X dropped, while also using a standard internal structure as a \"cost-saving measure\". However, the T-IT-N10Y's high price tag still scared off most potential buyers and is a rare sight as a result.\n\n<b><color=#e62e00>Quirk: Multi Trac</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.18</color></b>",
    "Icon": "GrandTitan"
  },
  "VariantName": "T-IT-N10Y",
