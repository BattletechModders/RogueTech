  "Description": {
    "Cost": 1525455,
    "UIName": "Canis",
    "Id": "chassisdef_canis_CAS-1",
    "Name": "Canis",
    "Details": "The energy weapons on the Canis are four arm-mounted Series 7Ja ER Large Lasers. While these pack a powerful, long-range punch, they often overload the design's sixteen double heat sinks. For medium-range support, the Canis utilizes a pair of torso-mounted Type 9 Ultra Autocannon/10s, though it only carries enough ammunition for approximately a minute and a half of sustained firing.\n\n<b><color=#e62e00>Quirk: Stable Weapons</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.2</color></b>\n\n<color=#FFEF00>Arm Actuator Limits: Left Lower, Right Lower</color>",
    "Icon": "uixTxrIcon_canis"
  },
