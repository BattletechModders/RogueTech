  "Description": {
    "Cost": 7974677,
    "UIName": "Turkina",
    "Id": "chassisdef_turkina_TKR-MCJ",
    "Name": "Turkina",
    "Details": "The MC/J loadout was created as part of the 'Master Creation' project, an attempt to have the best warriors create their ideal configurations. The MC/J is very similar to the MC/A, as it keeps the weapons the same: two LBX AC/10, two LBX AC/2, two ER Large Lasers, one Medium Pulse Laser and one LRM-5. But by dropping some armor and converting the chassis to Endo Steel, the space for three Jump Jets were freed.\n\n<b><color=#e62e00>Quirk: Aerial Assault</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.18</color></b>\n\n<color=#FFEF00>Arm Actuator Limits: Omni</color>",
    "Icon": "uixTxrIcon_turkina"
  },
