  "Description": {
    "Cost": 1017789,
    "UIName": "Cockroach",
    "Id": "chassisdef_cockroach_CRH-2B",
    "Name": "Cockroach",
    "Details": "The CRH-2B distinguishes itself through an unusual density of reinforced components, including an armored cockpit, armored engine shielding, a defensive-rated gyro, and reinforced leg and arm actuators that resist crippling damage. Ferro-Fibrous armor plating keeps weight manageable despite this added bulk, while internal spall liners reduce the risk of catastrophic crew or component loss from penetrating hits. Armed with twin PPCs and three Medium Lasers, and fitted with assault-class jump jets for repositioning, the CRH-2B remains a stubbornly difficult mech to put down for good.\n\n<b><color=#e62e00>Quirk: Reinforced Structure</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.14</color></b>",
    "Icon": "uixTxrIcon_ironclad"
  },
  "VariantName": "CRH-2B",
  "ChassisTags": {
    "items": [
