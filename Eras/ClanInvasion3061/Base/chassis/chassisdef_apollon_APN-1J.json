  "Description": {
    "Cost": 1072712,
    "UIName": "Apollon",
    "Id": "chassisdef_apollon_APN-1J",
    "Name": "Apollon",
    "Details": "The APN-1J is armed with two medium lasers and a machine gun, which is a surprising amount of weapons for 15-ton BattleMech considering it also sports 3 tons of standard armor. The drawback is the 90 rated engine core which leads to a - for ultralights - slow movement across the battlefield.\n\n<b><color=#e62e00>Quirk: Ubiquitous</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 0.97</color></b>",
    "Icon": "uixTxrIcon_stilettostardrive"
  },
  "VariantName": "APN-1J",
  "ChassisTags": {
    "items": [
      "Squad",
