  "Description": {
    "Cost": 2601280,
    "UIName": "Inferno",
    "Id": "chassisdef_inferno_INF-NOB",
    "Name": "Inferno",
    "Details": "A fire support configuration, the center torso carries an ER PPC and ER Small Laser. Each side torso carries an LRM-15 with two tons of ammo in a CASE II protected bay. The final weapon is another ER Small Laser mounted in the right torso. An extra double heat sink is mounted in the right torso as well.\n\n<b><color=#e62e00>Quirk: Battle Fists</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.06</color></b>\n\n<color=#FFEF00>Arm Actuator Limits: Omni</color>",
    "Icon": "uixTxrIcon_inferno"
  },
