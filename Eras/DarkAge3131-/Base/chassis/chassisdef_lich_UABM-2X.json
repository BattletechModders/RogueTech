  "Description": {
    "Cost": 1280125,
    "UIName": "Lich",
    "Id": "chassisdef_lich_UABM-2X",
    "Name": "Lich",
    "Details": "An experimental version of the Lich that incorporates an actual MechWarrior piloting it instead of remote controlling. Since the head is too small to fit a human, a torso mounted cockpit is needed. The freed weight capacity from removing the heavy remote drone control system is used to upgrade the engine, increase the armor and adding an extra Large Laser, but at the cost of downgrading to HarJel I instead HarJel II.\n\n<b><color=#e62e00>Quirk: Modular Weapons</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.18</color></b>",
    "Icon": "uixTxrIcon_kiso"
  },
  "VariantName": "UABM-2X",
  "ChassisTags": {
    "items": [
