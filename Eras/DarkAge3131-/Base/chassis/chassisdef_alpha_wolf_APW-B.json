  "Description": {
    "Cost": 8351960,
    "UIName": "Alpha Wolf",
    "Id": "chassisdef_alpha_wolf_APW-B",
    "Name": "Alpha Wolf",
    "Details": "The B configuration of the Alpha Wolf mounts two Large Pulse Lasers in the left arm and a Gauss Rifle in the right. Two shoulder mounted Artemis V-enabled SRM-6 launchers with two tons of ammo add the close range punch.\n\n<b><color=#e62e00>Quirk: Improved Jammer</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.17</color></b>\n\n<color=#FFEF00>Arm Actuator Limits: Omni</color>",
    "Icon": "uixTxrIcon_alphawolf"
  },
  "VariantName": "APW-B",
