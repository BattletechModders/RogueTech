  "Description": {
    "Cost": 3866274,
    "UIName": "Prey Seeker",
    "Id": "chassisdef_prey_seeker_PY-SR20",
    "Name": "Prey Seeker",
    "Details": "This variant drops the re-engineered lasers of the standard variant and instead mounts two ER Medium Lasers in each arm and one in the center torso, along with a Targeting Computer in the BattleMech's head.\n\n<b><color=#e62e00>Quirk: Extended Torso Twist</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 0.99</color></b>",
