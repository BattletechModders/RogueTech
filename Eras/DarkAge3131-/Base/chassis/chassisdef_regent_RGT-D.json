  "Description": {
    "Cost": 3283116,
    "UIName": "Regent",
    "Id": "chassisdef_regent_RGT-D",
    "Name": "Regent",
    "Details": "The D variant is a bit of jack of all trades, mounting a pair of Ultra AC/2, a pair of LBX AC/2, a pair of LRM-15 launchers and four Improved Heavy Medium Lasers. Eight tons of C.A.S.E. II protected ammunition and only two extra heat sinks finishes the design, meaning the 'Mech suffers from severe overheat issues.\n\n<b><color=#e62e00>Quirk: Easy to Maintain</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.17</color></b>\n\n<color=#FFEF00>Arm Actuator Limits: Omni</color>",
    "Icon": "uixTxrIcon_awesome"
  },
