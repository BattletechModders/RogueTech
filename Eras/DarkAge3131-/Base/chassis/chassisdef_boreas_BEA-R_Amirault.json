  "Description": {
    "Cost": 7594983,
    "UIName": "Boreas",
    "Id": "chassisdef_boreas_BEA-R_Amirault",
    "Name": "Boreas R 'Amirault'",
    "Details": "The Boreas R variant, also known as the Amirault, is a tribute to the renowned Hells Horses MechWarrior, Joshua Amirault. This variant features an Endo Steel frame that enhances its durability without sacrificing mobility. Its original weapon systems have been replaced with four LRM 15 missile launchers and three ER Medium Lasers, providing devastating long-range firepower coupled with moderate close-range capability. The emphasis on weapons leaves little room for cooling equipment, and the mech can run into heat management issues in prolonged combat\n\n<b><color=#e62e00>Quirk: Integrated Searchlight</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.11</color></b>",
    "Icon": "uixTxrIcon_boreas"
  },
  "VariantName": "BEA-R",
