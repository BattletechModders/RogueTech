  "Description": {
    "Cost": 4855204,
    "UIName": "Celerity",
    "Id": "chassisdef_celerity_CLR-03-OB",
    "Name": "Celerity",
    "Details": "The B loadout of the Republic's CLR-03-O OmniMech variant uses an Angel ECM suite to disrupt enemy electronics systems. This specific version has been further altered to add a small laser, the 'Mechs only weapon.\n\n<b><color=#e62e00>Quirk: Quad Mech (Squad)</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 0.94</color></b>",
