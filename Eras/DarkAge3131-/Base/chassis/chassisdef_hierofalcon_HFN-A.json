  "Description": {
    "Cost": 13206132,
    "UIName": "Hierofalcon",
    "Id": "chassisdef_hierofalcon_HFN-A",
    "Name": "Hierofalcon",
    "Details": "A close-range fighter with the added role of anti-infantry striker, this configuration features a right arm mounted large pulse laser, a pair of AP Gauss rifles split between the arms, two ER medium lasers, and a flamer mounted in the left arm. To assist it in reaching its targets, eight improved jump jets are also fitted.\n\n<b><color=#e62e00>Quirk: Distracting</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.04</color></b>",
    "Icon": "uixTxrIcon_hierofalcon"
  },
  "VariantName": "HFN-A",
  "ChassisTags": {
    "items": [
      "ClanMech",
      "OmniMech",
