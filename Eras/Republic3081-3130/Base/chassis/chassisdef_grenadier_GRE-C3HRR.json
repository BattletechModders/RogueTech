  "Description": {
    "Cost": 2750000,
    "UIName": "Grenadier",
    "Id": "chassisdef_grenadier_GRE-C3HRR",
    "Name": "Grenadier",
    "Details": "This Grenadier variant is equipped with a Firedrake Needler, Heavy Recoilless Rifle, and Battle Armor C3 system.\n\n<b><color=#e62e00>Quirk: Ambusher</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 0.896</color></b>\n\n<b><color=#2aad3b>Can only be transported by internal bays, can melee, can not swarm.</b></color>",
