  "Description": {
    "Cost": 1279208,
    "UIName": "Albatross",
    "Id": "chassisdef_albatross_ALB-5U",
    "Name": "Albatross",
    "Details": "The ALB-5U sought to maintain the 5W's robustness while appealing to the new AMSC. However, to add the extra armoring the firepower had to be reduced to a RAC/2, one Large X-Pulse Laser, one MML-7 and three ER standard lasers. This was seen as a bad amount of weapons considering the large size of the 'Mech, so the variant was never very popular.\n\n<b><color=#e62e00>Quirk: Improved Targeting - Long</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.17</color></b>\n\n<color=#FFEF00>Arm Actuator Limits: Left Lower, Right Lower</color>",
    "Icon": "Albatross"
  },
  "VariantName": "ALB-5U",
