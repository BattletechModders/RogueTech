  "dialogueList": [
    {
      "dialogue": {
        "EncounterObjectGuid": "73df8d9c-a274-48fd-98c9-2bd0d7860e83"
      },
      "name": "Dialogue_MissionStart",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Uh, Boss? I'm seeing a couple of Local attack lances on my screen, and I'm willing to bet their pilots are pretty angry.",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE"
        },
        {
          "words": "I'd wager they're furious. Get in there and take 'em out. Good hunting, Commander.",
          "selectedCastDefId": "castDef_FP_AgentX1",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "4011a4c3-cba2-4d22-b2b3-3b19a3297ab9"
      },
      "name": "Dialogue_MissionSuccess",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Impressive work, Commander. Lets get this data back to the Argo where we can sort it properly",
          "selectedCastDefId": "castDef_FP_AgentX1",
          "audioName": "NONE"
        },
        {
          "words": "Looks like we got a bonus as well.",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE"
        },
        {
          "words": "A well deserved one. I try to keep my guys happy. ",
          "selectedCastDefId": "castDef_FP_AgentX1",
          "audioName": "NONE"
        },
        {
          "words": "What about Duchess, She never seems 'happy'?",
          "selectedCastDefId": "castDef_YangDefault",
          "audioName": "NONE"
        },
        {
          "words": "Let's just say she has every right to be the way she is.",
          "selectedCastDefId": "castDef_FP_AgentX1",
          "audioName": "NONE"
        },
        {
          "words": "Roger that. Let's get out of here.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "d3d33d95-9ed7-4686-b9eb-954ebe51cc02"
      },
      "name": "Dialogue_MissionFailure",
      "overrideDialogueBucketId": "",
      "dialogueContent": [
        {
          "words": "Doesn't look good, Commander.",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    },
    {
      "dialogue": {
        "EncounterObjectGuid": "33166b96-5af2-4724-b970-7884ec41ffd0"
      },
      "name": "Dialogue_AmbushWarning",
      "overrideDialogueBucketId": "DialogBucketDef_Universal_HostilesInbound",
      "dialogueContent": [
        {
          "words": "A primary target is damaged, Commander! Keep it up!",
          "selectedCastDefId": "castDef_DariusDefault",
          "audioName": "NONE"
        }
      ]
    }
  ],
