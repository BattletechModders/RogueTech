  "Description": {
    "Cost": 2312500,
    "UIName": "Dragoon Battle Armor",
    "Id": "chassisdef_dragoon_battle_armor_DGN-STD",
    "Name": "Dragoon Battle Armor",
    "Details": "The Dragoon was conceived as a heavier, more versatile battlesuit for Wolf’s Dragoons’ Seventh Kommando. The Dragoon offers more protection and flexibility than common infiltration suits. This suit was originally designed to give combat engineers a degree of battlefield protection for high-risk intrusion operations, and to incorporate the ease of movement found in much lighter suits.\n\n<b><color=#e62e00>Quirk: Intuitive Controls</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 0.89</color></b>\n\n<b><color=#2aad3b>Can mount Omni units, can melee, can swarm.</b></color>",
    "Icon": "BA_ISStandard"
  },
