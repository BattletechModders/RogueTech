  "Description": {
    "Cost": 4334000,
    "UIName": "Gnome",
    "Id": "chassisdef_gnome_GNM-LRM",
    "Name": "Gnome",
    "Details": "The Gnome battle armor was created by Clan Hell's Horses in response to Inner Sphere responses to the ubiquitous Elemental battle armor.  Since its introduction the Gnome has been eclipsed in size by other assault-weight suits but still serves as the mainstay in most Hell's Horses' front-line Clusters and found its way into the toumans of other Clans through various Trials. \n\n<b><color=#e62e00>Quirk: Armored</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 0.935</color></b>\n\n<b><color=#2aad3b>Can mount Omni units, can melee, can not swarm.</b></color>",
    "Icon": "Gnome"
  },
