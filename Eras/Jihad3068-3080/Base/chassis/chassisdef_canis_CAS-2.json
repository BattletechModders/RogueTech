  "Description": {
    "Cost": 1525455,
    "UIName": "Canis",
    "Id": "chassisdef_canis_CAS-2",
    "Name": "Canis",
    "Details": "Developed during the Jihad in 3071, this is an upgrade in the design's weaponry. The 'Mech's Ultra Class autocannons are removed, for a pair of Class 20 Hyper-Assault Gauss Rifles with four tons of ammunition. Three of the 'Mech's ER Large Lasers are removed, with one being moved to its head. In their place, they've been given two Large Pulse Lasers.\n\n<b><color=#e62e00>Quirk: Stable Weapons</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.2</color></b>\n\n<color=#FFEF00>Arm Actuator Limits: Left Lower, Right Lower</color>",
    "Icon": "uixTxrIcon_canis"
  },
  "VariantName": "CAS-2",
  "ChassisTags": {
    "items": [
