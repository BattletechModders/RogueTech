  "Description": {
    "Cost": 2161500,
    "UIName": "Corona",
    "Id": "chassisdef_corona_COR-SRM",
    "Name": "Corona",
    "Details": "The Corona is a battle armor design that was created by Clan Star Adder following the Trials to determine which Clans would take part in Operation REVIVAL. The idea was to build the battlesuit around a weapon that could threaten 'Mechs from a distance. The mass necessary to mount such a heavy weapon resulted in a twenty percent armor decrease and the removal of the jump pack, despite a fifty percent overall increase in mass.\n\n<b><color=#e62e00>Quirk: Intimidating</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 0.935</color></b>\n\n<b><color=#2aad3b>Can mount Omni units, can melee, can not swarm.</b></color>",
    "Icon": "BA_Corona"
  },
