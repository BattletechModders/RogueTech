  "Description": {
    "Cost": 1455000,
    "UIName": "Trinity",
    "Id": "chassisdef_trinity_TRI-A-MRR_Sqd5",
    "Name": "Trinity",
    "Details": "This Taurian variant does not use mimetic armor, opting instead for standard armor that is easier to replace. It usually mounts a much easier to maintain Medium Recoilless Rifle, which actually deals half as much damage as the standard Plasma Rifle, but is supplied with twice as much ammunition.\n\n<b><color=#e62e00>Quirk: Accurate</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 0.89</color></b>\n\n<b><color=#2aad3b>Can mount Omni units, can melee, can swarm.</b></color>",
    "Icon": "BA_ISStandard"
  },
  "VariantName": "TRI-A-MRR(5)",
