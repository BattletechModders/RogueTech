  "Description": {
    "Cost": 1291395,
    "UIName": "Albatross",
    "Id": "chassisdef_albatross_ALB-5W",
    "Name": "Albatross",
    "Details": "The ALB-5W was built at the behest of the Word of Blake during the Jihad, serving most infamously as the basis for Precentor Dantalion’s custom command 'Mech. Carrying one ER PPC, one Large VSP Laser and six other assorted lasers lead to a very heat producing but high output firing profile. To improve it further, the ER PPC had a PPC Capacitor connected.\n\n<b><color=#e62e00>Quirk: Improved Targeting - Long</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.17</color></b>\n\n<color=#FFEF00>Arm Actuator Limits: Left Lower, Right Lower</color>",
    "Icon": "Albatross"
  },
  "VariantName": "ALB-5W",
