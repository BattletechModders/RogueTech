  "Description": {
    "Cost": 4681500,
    "UIName": "Elemental",
    "Id": "chassisdef_elemental_ii_TOAD-2X",
    "Name": "Elemental",
    "Details": "Reportedly developed in a mobile facility en route to the Inner Sphere, the Elemental II (X) is a prototype battle armor developed by Clan Hell's Horses to integrate the capabilities of the standard Elemental battlesuit (known to many in the Inner Sphere as \"Toad \" armor) with myomer-boosting technology. The goal of this experimental design was to enhance the Elemental as the Clans' \"gold standard\" in battle armor design, and produce a more effective general-purpose suit.\n\n<b><color=#e62e00>Quirk: Experimental Design</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 0.935</color></b>\n\n<b><color=#2aad3b>Can mount Omni units, can melee, can not swarm.</b></color>",
    "Icon": "BA_Elemental"
  },
