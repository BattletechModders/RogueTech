  "Description": {
    "Cost": 3365820,
    "UIName": "Black Knight",
    "Id": "chassisdef_blackknight_BL-X-KNT",
    "Name": "Black Knight",
    "Details": "Based on a BL-9-KNT chassis, this personal ride of Reginald VanJaster was created during the Word of Blake's occupation of Solaris. The standard weaponry was removed and replaced with a Large Shield and Large Vibroblade for hand to hand combat, while five Medium X-Pulse Lasers inflict huge amounts of damage in close quarter combat. For long range firepower, a single Heavy PPC paired with a PPC Capacitor are used. The whole 'Mech is protected by thirteen tons of armor. Fifteen double heat sinks are available to dissipate heat.\n\n<b><color=#e62e00>Quirk: Integrated TSM</color></b>\n\n<b><color=#e62e00>Drop Cost Multiplier: 1.13</color></b>",
    "Icon": "uixTxrIcon_redreaper"
  },
